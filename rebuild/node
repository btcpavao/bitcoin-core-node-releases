#!/bin/bash
set -euo pipefail
umask 022
recipe=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
source "$recipe/inputs.env"
usage() {
    echo 'Usage: bash rebuild/node source NEW_DIRECTORY | build NEW_DIRECTORY | compare ISO_A ISO_B' >&2
    exit 2
}
[[ $# -ge 2 ]] || usage
operation=$1
if [[ $operation == compare ]]; then
    [[ $# == 3 && -s $2 && -s $3 && -f $2 && -f $3 ]] || usage
    sha256sum -- "$2" "$3"
    cmp -- "$2" "$3"
    echo 'MATCH: every byte of the two ISO files is identical.'
    exit
fi
[[ $# == 2 && ( $operation == source || $operation == build ) ]] || usage
destination=$(realpath -m -- "$2")
[[ ! -e $destination && ! -L $destination && -d $(dirname -- "$destination") ]] || {
    echo 'Choose a new directory inside an existing parent folder.' >&2; exit 1;
}
scratch=$(mktemp -d)
staging=$(mktemp -d -- "$(dirname -- "$destination")/.node-rebuild.XXXXXXXX")
cleanup() { rm -rf -- "$scratch" "$staging"; }
trap cleanup EXIT
archive="bitcoin-core-node-$NODE_VERSION-source.tar.gz"
base="https://github.com/btcpavao/bitcoin-core-node-releases/releases/download/$NODE_VERSION"
cd "$scratch"
for file in "$archive" SHA256SUMS SHA256SUMS.asc SOURCE-COMMIT.txt; do
    curl --fail --location --retry 3 --proto '=https' --proto-redir '=https' --output "$file" "$base/$file"
done
install -d -m 700 gnupg
gpg --no-options --batch --homedir "$scratch/gnupg" --dearmor < "$recipe/../btcpavao-pgp.asc" > release.gpg
gpg --no-options --batch --homedir "$scratch/gnupg" --no-default-keyring \
    --keyring "$scratch/release.gpg" --no-auto-key-retrieve --status-fd 1 \
    --verify SHA256SUMS.asc SHA256SUMS > status
awk -v key="$RELEASE_KEY" '$1 == "[GNUPG:]" && $2 == "VALIDSIG" && $NF == key {valid=1} END {exit !valid}' status
grep -Fx "$SOURCE_DIGEST  $archive" SHA256SUMS >/dev/null
# Check every required input explicitly. Missing files are errors.
awk -v src="$archive" '$2 == src || $2 == "SOURCE-COMMIT.txt"' SHA256SUMS > required
test "$(wc -l < required)" = 2
sha256sum --check --strict required
test "$(cat SOURCE-COMMIT.txt)" = "$SOURCE_COMMIT"
mkdir "$scratch/source"
tar -xzf "$archive" --no-same-owner --strip-components=1 -C "$scratch/source"
(cd "$scratch/source" && patch --forward --batch --fuzz=0 -p1 < "$recipe/node.patch")
if [[ $operation == source ]]; then
    cp -a "$scratch/source/." "$staging/"
else
    command -v docker >/dev/null || { echo 'Docker Engine is required in the disposable build VM.' >&2; exit 1; }
    # Stable paths, hostname and architecture inside each new container. No
    # signing keys, disks, personal home directories or Docker socket are mounted.
    docker run --rm --privileged --platform linux/amd64 --hostname node-builder \
        --mount "type=bind,source=$scratch/source,target=/inputs,readonly" \
        --mount "type=bind,source=$recipe,target=/recipe,readonly" \
        --mount "type=bind,source=/etc/ssl/certs/ca-certificates.crt,target=/host-ca.pem,readonly" \
        --mount "type=bind,source=$staging,target=/out" \
        "$BUILDER_IMAGE" bash /recipe/builder.sh
    (cd "$staging" && sha256sum --strict --check SHA256SUMS)
fi
# Publish a complete result only; concurrent runs cannot replace one another.
mv --no-target-directory --no-clobber -- "$staging" "$destination"
[[ ! -d $staging ]] || { echo 'Another run created the destination first.' >&2; exit 1; }
printf 'Complete: %s\n' "$destination"
