@@ -0,0 +1,98 @@
+"""Portable scale backup keeps the destination's monitor layout and file safety."""
+import copy
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'app'))
+import settings_snapshot as snapshot
+import settings_restore as restore
+
+
+def profile():
+    return dict(kind='bitcoin-core-display-settings',version=1,product='node',
+                hardware=[dict(name='eDP-1',edid='a'*64),dict(name='HDMI-1',edid='b'*64)],
+                layout=dict(outputs=[
+                    dict(name='eDP-1',mode='1920x1080',rate='60',x=0,y=0,rotation='normal',primary=True),
+                    dict(name='HDMI-1',mode='1920x1080',rate='60',x=1920,y=0,rotation='normal',primary=False)],
+                    scale='1.5',preset='extend',arrangement='right'))
+
+
+class ScaleBackup(unittest.TestCase):
+    def setUp(self):
+        self.work=tempfile.TemporaryDirectory()
+        self.addCleanup(self.work.cleanup)
+        self.root=Path(self.work.name)
+        self.path=self.root/'home/node/.config/core-desktop/display.json'
+        self.path.parent.mkdir(parents=True)
+        (self.root/'etc').mkdir()
+        (self.root/'etc/core-display-scale.conf').write_text('1.25\n')
+        self.account=SimpleNamespace(pw_uid=os.getuid(),pw_gid=os.getgid())
+
+    def write(self,data=None):
+        self.path.write_bytes(snapshot.canonical(data or profile()))
+        self.path.chmod(0o600)
+
+    def test_confirmed_profile_scale_takes_precedence(self):
+        self.write()
+        self.assertEqual(snapshot.collect_display_scale(self.root,os.getuid()),'1.5')
+
+    def test_legacy_default_is_preserved_without_profile(self):
+        self.assertEqual(snapshot.collect_display_scale(self.root,os.getuid()),'1.25')
+        self.assertEqual(restore.display_scale_plan('2',self.root,self.account),{})
+        self.assertFalse(self.path.exists())
+
+    def test_restore_updates_only_scale_and_preserves_target_layout(self):
+        self.write()
+        before=self.path.read_bytes()
+        expected=snapshot.display_profile(before)
+        expected['layout']['scale']='2.5'
+        plan=restore.display_scale_plan('2.50',self.root,self.account)
+        self.assertEqual(set(plan),{'home/node/.config/core-desktop/display.json'})
+        import base64
+        record=next(iter(plan.values()))
+        self.assertEqual(json.loads(base64.b64decode(record['data'])),expected)
+        self.assertEqual((record['uid'],record['gid'],record['mode']),
+                         (os.getuid(),os.getgid(),0o600))
+        self.assertEqual(self.path.read_bytes(),before,'Planning must not mutate the target.')
+
+    def test_full_supported_scale_range_and_invalid_inputs(self):
+        for value,want in [('auto','auto'),('1.0','1'),('1.25','1.25'),('2.75','2.75'),('3.0','3')]:
+            with self.subTest(value=value):self.assertEqual(snapshot.display_scale(value),want)
+        for value in (True,1,None,{},'0.99','3.01','NaN','Infinity','1; id','$(id)','1\n','1e999'):
+            with self.subTest(value=value),self.assertRaises(snapshot.SettingsError):snapshot.display_scale(value)
+
+    def test_invalid_or_foreign_profile_does_not_silently_override(self):
+        for change in ('foreign','unknown','duplicate','invalid_scale'):
+            data=profile()
+            if change=='foreign':data['product']='vault'
+            elif change=='unknown':data['command']='touch /tmp/unwanted'
+            elif change=='duplicate':data['layout']['outputs'].append(copy.deepcopy(data['layout']['outputs'][0]))
+            else:data['layout']['scale']='nan'
+            self.write(data)
+            with self.subTest(change=change),self.assertRaises(snapshot.SettingsError):
+                restore.display_scale_plan('2',self.root,self.account)
+
+    def test_symbolic_and_hard_links_are_rejected(self):
+        self.write()
+        real=self.path.with_name('original.json')
+        self.path.rename(real)
+        self.path.symlink_to(real)
+        with self.assertRaises((OSError,snapshot.SettingsError)):
+            snapshot.collect_display_scale(self.root,os.getuid())
+        self.path.unlink()
+        os.link(real,self.path)
+        with self.assertRaises(snapshot.SettingsError):
+            restore.display_scale_plan('2',self.root,self.account)
+
+    def test_only_exact_display_profile_destination_is_allowlisted(self):
+        self.assertTrue(restore.allowed('home/node/.config/core-desktop/display.json'))
+        for name in ('profile.json','../bitcoin-core-node/wallet.dat','display.json/child'):
+            self.assertFalse(restore.allowed('home/node/.config/core-desktop/'+name))
+
+
+if __name__=='__main__':unittest.main(verbosity=2)
