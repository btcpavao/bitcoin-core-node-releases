+"""Offscreen UI behavior, with only disposable simulated display data."""
+import copy
+import os
+from pathlib import Path
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+from shared_display_fixtures import SimulatedBackend, initial, requested, display
+from PySide6.QtCore import Qt
+from PySide6.QtTest import QTest
+from PySide6.QtWidgets import QApplication, QPushButton
+from core_display_settings import DisplaySettingsDialog, KeepDialog, configure_application
+
+
+class DisplayUiTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+        configure_application(cls.app)
+
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        self.backend = SimulatedBackend(self.root / 'backend')
+        self.environment = patch.dict(os.environ, HOME=str(self.root / 'home'))
+        self.environment.start()
+        self.dialogs = []
+
+    def tearDown(self):
+        for dialog in self.dialogs:
+            self.wait_idle(dialog)
+            dialog.reject()
+            dialog.deleteLater()
+        self.app.processEvents()
+        self.environment.stop()
+        self.temp.cleanup()
+
+    def open(self, product='node', imported=None):
+        dialog = DisplaySettingsDialog(product=product, backend=self.backend, imported_profile=imported)
+        self.dialogs.append(dialog)
+        dialog.show()
+        self.wait_idle(dialog)
+        return dialog
+
+    def wait_idle(self, dialog):
+        deadline = time.monotonic() + 5
+        while dialog.busy() and time.monotonic() < deadline:
+            self.app.processEvents()
+            QTest.qWait(5)
+        self.assertFalse(dialog.busy())
+        self.app.processEvents()
+
+    def test_dialog_lists_connected_disabled_monitor_without_applying(self):
+        dialog = self.open()
+        self.assertEqual(set(dialog.rows), {'eDP-1', 'HDMI-1'})
+        self.assertEqual(dialog.mode.currentData(), 'built-in')
+        self.assertEqual(dialog.rows['HDMI-1'].resolution.count(), 3)
+        self.assertFalse(self.backend.events_path.exists())
+
+    def test_four_modes_and_external_only_target(self):
+        dialog = self.open()
+        self.assertEqual([dialog.mode.itemData(i) for i in range(dialog.mode.count())],
+                         ['built-in', 'mirror', 'extend', 'external'])
+        dialog.mode.setCurrentIndex(dialog.mode.findData('external'))
+        layout = dialog.requested_layout()
+        self.assertEqual([o['name'] for o in layout['outputs']], ['HDMI-1'])
+        self.assertTrue(layout['outputs'][0]['primary'])
+        self.assertFalse(dialog.rows['eDP-1'].isEnabled())
+
+    def test_mirror_only_offers_compatible_resolution_and_refresh(self):
+        dialog = self.open()
+        dialog.mode.setCurrentIndex(dialog.mode.findData('mirror'))
+        self.assertEqual([dialog.mirror_resolution.itemData(i) for i in range(dialog.mirror_resolution.count())],
+                         [(1920, 1080), (1280, 720)])
+        self.assertEqual([dialog.mirror_rate.itemData(i) for i in range(dialog.mirror_rate.count())], ['60', '59.94'])
+        layout = dialog.requested_layout()
+        self.assertEqual({(o['mode'], o['rate'], o['x'], o['y']) for o in layout['outputs']},
+                         {('1920x1080', '60', 0, 0)})
+        self.assertFalse(dialog.rows['HDMI-1'].resolution.isEnabled())
+
+    def test_extend_left_positions_primary_after_other_monitor(self):
+        dialog = self.open()
+        dialog.mode.setCurrentIndex(dialog.mode.findData('extend'))
+        dialog.primary.setCurrentIndex(dialog.primary.findData('eDP-1'))
+        dialog.arrangement.setCurrentIndex(dialog.arrangement.findData('left'))
+        layout = dialog.requested_layout()
+        by_name = {o['name']: o for o in layout['outputs']}
+        self.assertEqual(by_name['HDMI-1']['x'], 0)
+        self.assertEqual(by_name['eDP-1']['x'], 1920)
+
+    def test_import_stages_then_requires_apply(self):
+        profile = requested()
+        profile['product'] = 'node'
+        dialog = self.open(product='vault', imported=profile)
+        self.assertEqual(dialog.mode.currentData(), 'external')
+        self.assertEqual(dialog.scale.currentData(), '1.25')
+        self.assertIn('no display settings have changed', dialog.status.text())
+        self.assertFalse(self.backend.events_path.exists())
+        self.assertFalse(display.profile_path('vault').exists())
+
+    def test_disconnected_monitor_import_does_not_apply_or_stage_wrong_target(self):
+        profile = requested()
+        profile['hardware'][0]['edid'] = 'f' * 64
+        dialog = self.open(imported=profile)
+        self.assertIn('different connected displays', dialog.status.text())
+        self.assertFalse(self.backend.events_path.exists())
+
+    def test_orientation_hidden_until_advanced(self):
+        dialog = self.open()
+        self.assertFalse(dialog.rows['eDP-1'].rotation.isVisible())
+        dialog.advanced.setChecked(True)
+        self.assertTrue(dialog.rows['eDP-1'].rotation.isVisible())
+
+    def test_small_window_keeps_actions_accessible_outside_scroll(self):
+        dialog = self.open()
+        dialog.resize(760, 550)
+        self.app.processEvents()
+        for button in (dialog.apply_button, dialog.back_button, dialog.export_button, dialog.import_button):
+            rectangle = button.geometry()
+            self.assertLessEqual(rectangle.bottom(), dialog.height())
+            self.assertLessEqual(rectangle.right(), dialog.width())
+            self.assertTrue(button.isVisible())
+
+    def test_confirmation_close_requests_revert_once(self):
+        owner = self.open()
+        popup = KeepDialog(15, owner)
+        decisions = []
+        popup.decision.connect(decisions.append)
+        popup.show()
+        popup.reject()
+        popup.reject()
+        self.assertEqual(decisions, ['revert'])
+        popup.deleteLater()
+
+    def test_confirmation_keep_has_stable_selector(self):
+        owner = self.open()
+        popup = KeepDialog(15, owner)
+        decisions = []
+        popup.decision.connect(decisions.append)
+        popup.show()
+        button = popup.findChild(QPushButton, 'DisplayKeep')
+        self.assertIsNotNone(button)
+        button.click()
+        self.assertEqual(decisions, ['keep'])
+        popup.deleteLater()
+
+
+if __name__ == '__main__':
+    unittest.main()
