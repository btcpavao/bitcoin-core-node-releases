+"""Behavioral display tests: parsing, validation, rollback and process death."""
+import copy
+import json
+import os
+from pathlib import Path
+import select
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+from shared_display_fixtures import (ROOT, QUERY, VERBOSE, SimulatedBackend, events,
+                                     initial, requested, display)
+
+
+class ParsingTests(unittest.TestCase):
+    def test_connected_disabled_output_and_edid_are_retained(self):
+        snapshot = initial()
+        self.assertEqual([o.name for o in snapshot.active], ['eDP-1'])
+        self.assertEqual([o.name for o in snapshot.connected], ['eDP-1', 'HDMI-1'])
+        hdmi = snapshot.find('HDMI-1')
+        self.assertEqual(hdmi.preferred_mode().name, '1920x1080')
+        self.assertEqual(hdmi.find_mode('1920x1080').rates, ['60', '59.94', '50'])
+        self.assertNotEqual(hdmi.edid, snapshot.find('eDP-1').edid)
+        self.assertEqual(len(hdmi.edid), 64)
+
+    def test_rotation_and_position_from_query(self):
+        text = QUERY.replace('1920x1080+0+0 (normal', '1080x1920+1920+0 left (normal', 1)
+        output = display.parse_query(text).find('eDP-1')
+        self.assertEqual((output.rotation, output.x, output.width), ('left', 1920, 1080))
+
+    def test_verbose_topology_race_is_rejected(self):
+        with self.assertRaises(display.DisplayError):
+            display.add_transforms(initial(), VERBOSE.replace('HDMI-1 connected', 'HDMI-1 disconnected'))
+
+    def test_custom_transform_is_captured_for_rollback(self):
+        snapshot = display.parse_query(QUERY)
+        text = VERBOSE.replace('Transform: 1.000000', 'Transform: 1.250000', 1)
+        display.add_transforms(snapshot, text)
+        self.assertEqual(snapshot.find('eDP-1').transform[0], '1.250000')
+
+    def test_virtual_output_zero_clock_is_automatic_and_normal_only(self):
+        text = 'Screen 0: minimum 1 x 1, current 1280 x 800, maximum 1280 x 800\n' \
+               'screen connected 1280x800+0+0 0mm x 0mm\n   1280x800 0.00*\n'
+        snapshot = display.parse_query(text)
+        self.assertEqual(snapshot.find('screen').rate, '0')
+        self.assertEqual(snapshot.find('screen').rotations, ('normal',))
+        layout = display.layout_from_snapshot(snapshot)
+        self.assertNotIn('--rate', display.command_for_layout(layout, snapshot))
+        layout['outputs'][0]['rotation'] = 'left'
+        with self.assertRaises(display.DisplayError):
+            display.validate_live_layout(layout, snapshot)
+
+
+class ValidationTests(unittest.TestCase):
+    def test_declarative_profile_rejects_commands_paths_and_unknown_fields(self):
+        for field in ('command', 'path', 'script', 'transform'):
+            data = requested()
+            data['layout']['outputs'][0][field] = 'touch /tmp/unwanted'
+            with self.subTest(field=field), self.assertRaises(display.DisplayError):
+                display.validate_profile(data)
+
+    def test_scale_rejects_bools_nan_infinity_and_out_of_range(self):
+        for value in (True, False, 'nan', 'Infinity', 0, -1, 3.01, [], {}):
+            with self.subTest(value=value), self.assertRaises(display.DisplayError):
+                display.validate_scale(value)
+        self.assertEqual(display.validate_scale('1.2500'), '1.25')
+        self.assertEqual(display.validate_scale('auto'), 'auto')
+
+    def test_duplicates_nonstandard_json_and_oversize_rejected(self):
+        for raw in ('{"a":1,"a":2}', '{"a":NaN}', '[' * 2000, ' ' * (display.PROFILE_LIMIT + 1)):
+            with self.subTest(raw=raw[:20]), self.assertRaises(display.DisplayError):
+                display.decode_json(raw)
+
+    def test_unsupported_mode_and_rate_rejected_before_commands(self):
+        snapshot = initial()
+        for key, value in [('mode', '9999x9999'), ('rate', '144')]:
+            data = requested(snapshot)['layout']
+            data['outputs'][0][key] = value
+            with self.subTest(key=key), self.assertRaises(display.DisplayError):
+                display.command_for_layout(data, snapshot)
+
+    def test_no_disabled_all_outputs_or_multiple_primary(self):
+        data = requested()['layout']
+        data['outputs'] = []
+        with self.assertRaises(display.DisplayError):
+            display.validate_layout(data)
+        data = requested()['layout']
+        data['outputs'][0]['primary'] = False
+        with self.assertRaises(display.DisplayError):
+            display.validate_layout(data)
+
+    def test_output_identifiers_cannot_be_shell_or_option_fragments(self):
+        for name in ('--off', 'HDMI-1;touch /tmp/x', 'HDMI 1', '../../output', 'x\n--off'):
+            data = requested()
+            data['layout']['outputs'][0]['name'] = name
+            with self.subTest(name=name), self.assertRaises(display.DisplayError):
+                display.validate_profile(data)
+
+    def test_mirror_checks_shared_dimensions_and_rates(self):
+        snapshot = initial()
+        layout = requested(snapshot)['layout']
+        layout['preset'] = 'mirror'
+        internal = dict(name='eDP-1', mode='1920x1080', rate='60', x=0, y=0, rotation='normal', primary=False)
+        layout['outputs'].append(internal)
+        self.assertEqual(display.validate_live_layout(layout, snapshot)['preset'], 'mirror')
+        internal['rate'] = '59.94'
+        with self.assertRaises(display.DisplayError):
+            display.validate_live_layout(layout, snapshot)
+
+    def test_framebuffer_bound_is_checked(self):
+        snapshot = initial()
+        snapshot.maximum = (1920, 1080)
+        layout = requested(snapshot)['layout']
+        layout['outputs'][0]['x'] = 1920
+        with self.assertRaises(display.DisplayError):
+            display.validate_live_layout(layout, snapshot)
+
+    def test_automatic_replay_requires_all_identities(self):
+        snapshot = initial()
+        self.assertTrue(display.matches_hardware(requested(snapshot), snapshot, automatic=True))
+        snapshot.find('HDMI-1').edid = None
+        profile = requested(snapshot)
+        self.assertFalse(display.matches_hardware(profile, snapshot, automatic=True))
+        self.assertTrue(display.matches_hardware(profile, snapshot, automatic=False))
+
+    def test_profiles_cannot_read_symlinks_or_fifos(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            regular = root / 'real.json'
+            regular.write_text(json.dumps(requested()))
+            (root / 'link.json').symlink_to(regular)
+            os.mkfifo(root / 'pipe.json')
+            for path in (root / 'link.json', root / 'pipe.json'):
+                with self.subTest(path=path), self.assertRaises((OSError, display.DisplayError)):
+                    display.read_profile(path)
+
+    def test_vault_saved_preferences_require_tmpfs(self):
+        with tempfile.TemporaryDirectory() as directory, patch.dict(os.environ, HOME=directory), \
+                patch.object(display, '_filesystem_type', return_value='ext4'):
+            with self.assertRaises(display.DisplayError):
+                display.save_profile('vault', requested())
+            self.assertFalse(display.profile_path('vault').exists())
+
+    def test_vault_uses_fixed_home_and_rejects_nested_persistent_mount(self):
+        with patch.dict(os.environ, HOME='/tmp/other-home', XDG_CONFIG_HOME='/media/usb'):
+            self.assertEqual(display.profile_path('vault'), Path('/home/vault/.config/core-desktop/display.json'))
+        mounts = ('1 0 8:1 / / rw - ext4 /dev/sda1 rw\n'
+                  '2 1 0:1 /home /home/vault rw - tmpfs tmpfs rw\n'
+                  '3 2 8:2 / /home/vault/.config rw - ext4 /dev/sdb1 rw\n')
+        original_read = Path.read_text
+        def read(path, *args, **kwargs):
+            return mounts if str(path) == '/proc/self/mountinfo' else original_read(path, *args, **kwargs)
+        with patch.object(Path, 'read_text', read):
+            self.assertEqual(display._filesystem_type(Path('/home/vault/.config/core-desktop')), 'ext4')
+            with self.assertRaises(display.DisplayError):
+                display._assert_vault_profile_path(display.profile_path('vault'))
+
+    def test_launch_environment_updates_gtk_without_restarting_processes(self):
+        with tempfile.TemporaryDirectory() as directory, patch.dict(os.environ,
+                XDG_RUNTIME_DIR=directory, GDK_SCALE='1', QT_SCALE_FACTOR='2'):
+            (Path(directory) / 'core-display-scale.json').write_text('{"scale":2.25,"dpi":216}')
+            env = display.launch_environment()
+            self.assertEqual(env['GDK_SCALE'], '2')
+            self.assertEqual(env['GDK_DPI_SCALE'], '0.5')
+            self.assertNotIn('QT_SCALE_FACTOR', env)
+            self.assertEqual(os.environ['GDK_SCALE'], '1')
