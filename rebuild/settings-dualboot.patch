+"""Device profiles reject arbitrary state and require separate display confirmation."""
+import copy
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'app'))
+import device_profile_data as profile
+import desktop_input
+import pointer_control
+
+
+def sample():
+    return {'kind': profile.KIND, 'version': 1,
+            'input': {'layout': {'model': 'pc105', 'layout': 'us', 'variant': '', 'options': ''},
+                      'preferences': copy.deepcopy(desktop_input.DEFAULTS),
+                      'pointer': {'schema': 1, 'devices': {'Fixture mouse': .3}}},
+            'display': None}
+
+
+class DeviceProfiles(unittest.TestCase):
+    def test_round_trip_and_no_overwrite(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'device-settings.json'
+            profile.write(path, sample(), 'node')
+            self.assertEqual(profile.read(path, 'node'), sample())
+            self.assertEqual(path.stat().st_mode & 0o777, 0o600)
+            before = path.read_bytes()
+            with self.assertRaises(FileExistsError):
+                profile.write(path, sample(), 'node')
+            self.assertEqual(path.read_bytes(), before)
+
+    def test_rejects_secrets_commands_clock_and_unknown_fields(self):
+        for key in ('wallet', 'password', 'command', 'path', 'clock', 'network'):
+            value = sample(); value[key] = '/tmp/anything'
+            with self.subTest(key=key), self.assertRaises(ValueError):
+                profile.validate(value, 'node')
+        for key in ('layout', 'preferences', 'pointer'):
+            value = sample(); value['input'][key]['command'] = 'touch /tmp/unwanted'
+            with self.subTest(key=key), self.assertRaises(ValueError):
+                profile.validate(value, 'node')
+        for number in (float('nan'), float('inf'), True, 1.01, '0.3'):
+            value = sample(); value['input']['pointer']['devices']['mouse'] = number
+            with self.subTest(number=number), self.assertRaises(ValueError):
+                profile.validate(value, 'node')
+
+    def test_bounded_regular_input_refuses_symlinks_fifo_duplicate_keys(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            valid = root / 'valid'; valid.write_text(json.dumps(sample()))
+            link = root / 'link'; link.symlink_to(valid)
+            with self.assertRaises(OSError):
+                profile.read(link, 'node')
+            fifo = root / 'fifo'; os.mkfifo(fifo)
+            with self.assertRaises(ValueError):
+                profile.read(fifo, 'node')
+            bad = root / 'bad'
+            for raw in ('{"version":1,"version":1}', 'x' * (profile.MAX_BYTES+1), '{"number":NaN}'):
+                bad.write_text(raw)
+                with self.assertRaises(ValueError):
+                    profile.read(bad, 'node')
+
+    def test_validation_is_complete_before_any_input_action(self):
+        value = sample(); value['input']['pointer']['devices']['mouse'] = 5
+        with patch.object(desktop_input, 'apply_keyboard') as apply:
+            with self.assertRaises(ValueError):
+                profile.apply_input(value, 'node')
+            apply.assert_not_called()
+
+    def test_display_import_validation_does_not_apply_or_save_display(self):
+        backend = Mock()
+        backend.validate_profile.return_value = {'validated': True}
+        value = sample(); value['display'] = {'synthetic': True}
+        with patch.object(profile, 'display_backend', return_value=backend):
+            result = profile.validate(value, 'node')
+        self.assertEqual(result['display'], {'validated': True})
+        backend.validate_profile.assert_called_once_with(value['display'])
+        backend.start_transaction.assert_not_called()
+        backend.save_profile.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
