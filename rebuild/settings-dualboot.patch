+"""Actual gear navigation and bounded Settings layout without OS changes."""
+import os
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'app'))
+from PySide6.QtCore import QPoint, QRect
+from PySide6.QtWidgets import QApplication
+import ui
+import connection_ui
+
+APP = QApplication.instance() or QApplication(['unified-settings-test'])
+APP.setQuitOnLastWindowClosed(False)
+ui.configure_ui(APP)
+
+
+class UnifiedSettings(unittest.TestCase):
+    def test_gear_reuses_one_settings_window_and_wifi_remains_in_menu(self):
+        with patch.object(ui.Home, 'poll_wallets', lambda self: None), \
+                patch.object(ui.Home, 'poll_activity', lambda self: None), \
+                patch.object(connection_ui.ConnectionButton, 'poll', lambda self: None):
+            home = ui.Home(); home.show()
+            try:
+                self.assertFalse(hasattr(home, 'network_button'))
+                self.assertEqual(home.settings_button.accessibleName(), 'Settings')
+                home.settings_button.click(); APP.processEvents()
+                first = home.settings_dialog
+                self.assertFalse(first.isModal())
+                self.assertIn('Network Connections', first.cards)
+                self.assertIn('Display Settings', first.cards)
+                self.assertEqual(len(first.cards), 10)
+                home.settings_button.click(); APP.processEvents()
+                self.assertIs(home.settings_dialog, first)
+                for width, height in ((760, 550), (960, 555)):
+                    first.resize(width, height)
+                    for _ in range(4): APP.processEvents()
+                    self.assertEqual(first.cards_scroll.verticalScrollBar().maximum(), 0)
+                    for card in first.cards.values():
+                        pos = card.mapTo(first, QPoint())
+                        self.assertLessEqual(pos.y()+card.height(), first.exit_button.y())
+                # Simulate the former monitor disappearing or shrinking without
+                # touching the real X server. The entire dialog stays reachable.
+                first.move(1900, 900)
+                home.recover_windows([QRect(0, 0, 800, 560)])
+                APP.processEvents()
+                self.assertLessEqual(first.frameGeometry().right(), 799)
+                self.assertLessEqual(first.frameGeometry().bottom(), 559)
+                self.assertGreaterEqual(first.frameGeometry().left(), 0)
+                first.exit_button.click(); APP.processEvents()
+                self.assertIsNone(home.settings_dialog)
+            finally:
+                home.timer.stop(); home.wallet_inventory_timer.stop()
+                home.clock.timer.stop(); home.connection_button.timer.stop()
+                home.hide(); home.deleteLater(); APP.processEvents()
+
+    def test_new_applications_receive_current_scale_environment(self):
+        from types import SimpleNamespace
+        module = SimpleNamespace(launch_environment=lambda: {'GDK_SCALE':'2','GDK_DPI_SCALE':'0.5'})
+        with patch.dict(sys.modules, {'core_display': module}), \
+                patch.dict(os.environ, {'GDK_SCALE':'1','QT_SCALE_FACTOR':'2'}):
+            ui.Home.refresh_launch_environment(None)
+            self.assertEqual(os.environ['GDK_SCALE'], '2')
+            self.assertEqual(os.environ['GDK_DPI_SCALE'], '0.5')
+            self.assertNotIn('QT_SCALE_FACTOR', os.environ)
+
+
+if __name__ == '__main__':
+    unittest.main()
