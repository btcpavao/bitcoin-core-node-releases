+class BackendCommandsTests(unittest.TestCase):
+    def test_apply_command_is_argument_array_and_disables_only_unselected_connected_outputs(self):
+        args = display.command_for_layout(requested()['layout'], initial())
+        self.assertIsInstance(args, list)
+        self.assertEqual(args[0], '/usr/bin/xrandr')
+        self.assertNotIn('--noprimary', args)
+        self.assertIn('--primary', args)
+        self.assertEqual(args[-3:], ['--output', 'eDP-1', '--off'])
+        self.assertNotIn('DP-1', args)
+
+    def test_rollback_preserves_original_transform(self):
+        calls = []
+        def runner(args, **kwargs):
+            calls.append(args)
+            output = QUERY if '--query' in args else (VERBOSE if '--verbose' in args else '')
+            return subprocess.CompletedProcess(args, 0, output, '')
+        before = initial()
+        before.find('eDP-1').transform = ('1.25', '0', '0', '0', '1.25', '0', '0', '0', '1')
+        display.Backend(runner).restore(before)
+        self.assertIn('1.25,0,0,0,1.25,0,0,0,1', calls[-1])
+        self.assertEqual(calls[-1][-3:], ['--output', 'HDMI-1', '--off'])
+
+    def test_zero_panning_is_not_sent_to_fixed_virtual_outputs(self):
+        args = display.command_for_layout(requested()['layout'], initial())
+        self.assertNotIn('--panning', args)
+        snapshot = initial()
+        snapshot.find('HDMI-1').panning = '2560x1440+0+0'
+        args = display.command_for_layout(requested()['layout'], snapshot)
+        self.assertIn('--panning', args)
+
+    def test_rollback_restores_absence_of_explicit_primary(self):
+        calls = []
+        def runner(args, **kwargs):
+            calls.append(args)
+            output = QUERY if '--query' in args else (VERBOSE if '--verbose' in args else '')
+            return subprocess.CompletedProcess(args, 0, output, '')
+        before = initial()
+        before.find('eDP-1').primary = False
+        display.Backend(runner).restore(before)
+        self.assertIn('--noprimary', calls[-1])
+        self.assertNotIn('--primary', calls[-1])
+        self.assertEqual(calls[-1][calls[-1].index('--transform') + 1], 'none')
+
+
+class TransactionTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        self.home = self.root / 'home'
+        self.runtime = self.root / 'runtime'
+        self.backend_dir = self.root / 'backend'
+        self.home.mkdir()
+        self.runtime.mkdir(mode=0o700)
+        self.env = dict(os.environ, HOME=str(self.home), XDG_RUNTIME_DIR=str(self.runtime))
+        self.backend = SimulatedBackend(self.backend_dir)
+        self.original = display.make_profile('node', initial(), display.layout_from_snapshot(initial()))
+        target = self.home / '.config/core-desktop/display.json'
+        target.parent.mkdir(parents=True)
+        target.write_text(json.dumps(self.original))
+        self.original_bytes = target.read_bytes()
+        self.children = []
+
+    def tearDown(self):
+        for child in self.children:
+            if child.poll() is None:
+                child.kill()
+            child.wait(timeout=5)
+            for stream in (child.stdin, child.stdout, child.stderr):
+                if stream is not None:
+                    stream.close()
+        self.temp.cleanup()
+
+    def spawn(self, timeout=2):
+        child = subprocess.Popen([sys.executable, __file__, '--worker', str(self.backend_dir), str(timeout)],
+                                 stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                 env=self.env, start_new_session=True, bufsize=0)
+        self.children.append(child)
+        child.stdin.write((json.dumps(requested()) + '\n').encode())
+        child.stdin.flush()
+        ready, _, _ = select.select([child.stdout], [], [], 5)
+        self.assertTrue(ready, 'Worker did not report a state.')
+        state = json.loads(child.stdout.readline())
+        return child, state
+
+    def finish(self, child):
+        child.wait(timeout=6)
+        output = child.stdout.read().decode()
+        errors = child.stderr.read().decode()
+        self.assertFalse(errors, errors)
+        return [json.loads(line) for line in output.splitlines()]
+
+    def assert_reverted(self):
+        self.assertEqual([o.name for o in self.backend.probe().active], ['eDP-1'])
+        target = self.home / '.config/core-desktop/display.json'
+        self.assertEqual(target.read_bytes(), self.original_bytes)
+        self.assertIn('restore', [event['event'] for event in events(self.backend_dir)])
+        self.assertFalse((self.runtime / 'core-display/pending.json').exists())
+
+    def test_keep_commits_confirmed_profile_only(self):
+        child, state = self.spawn()
+        self.assertEqual(state['state'], 'pending')
+        self.assertEqual((self.home / '.config/core-desktop/display.json').read_bytes(), self.original_bytes)
+        child.stdin.write(b'keep\n')
+        result = self.finish(child)
+        self.assertEqual(result[-1]['state'], 'kept')
+        profile = display.read_profile(self.home / '.config/core-desktop/display.json')
+        self.assertEqual(profile['layout']['outputs'][0]['name'], 'HDMI-1')
+        self.assertFalse((self.runtime / 'core-display/pending.json').exists())
+
+    def test_timeout_restores_layout_and_keeps_old_preferences(self):
+        child, state = self.spawn(timeout=0.3)
+        self.assertEqual(state['state'], 'pending')
+        self.assertEqual(self.finish(child)[-1]['state'], 'reverted')
+        self.assert_reverted()
+
+    def test_eof_restores_layout(self):
+        child, state = self.spawn()
+        self.assertEqual(state['state'], 'pending')
+        child.stdin.close()
+        self.finish(child)
+        self.assert_reverted()
+
+    def test_explicit_revert_restores_layout(self):
+        child, _ = self.spawn()
+        child.stdin.write(b'revert\n')
+        self.finish(child)
+        self.assert_reverted()
+
+    def test_sigterm_restores_layout(self):
+        child, _ = self.spawn()
+        child.terminate()
+        self.finish(child)
+        self.assert_reverted()
+
+    def test_partial_apply_failure_is_rolled_back(self):
+        (self.backend_dir / 'fail-apply').touch()
+        child, state = self.spawn()
+        self.assertEqual(state['state'], 'error')
+        self.finish(child)
+        self.assert_reverted()
+
+    def test_changed_hardware_during_confirmation_reverts(self):
+        child, _ = self.spawn(timeout=3)
+        changed = self.backend.probe()
+        changed.find('HDMI-1').connected = False
+        self.backend.write(changed)
+        self.finish(child)
+        self.assert_reverted()
+
+    def test_killed_worker_is_recovered_from_ram_journal(self):
+        child, _ = self.spawn(timeout=5)
+        child.kill()
+        self.finish(child)
+        self.assertTrue((self.runtime / 'core-display/pending.json').exists())
+        with patch.dict(os.environ, self.env):
+            self.assertTrue(display.recover_abandoned('node', self.backend))
+        self.assert_reverted()
+
+    def test_interrupted_preference_commit_restores_previous_profile(self):
+        (self.backend_dir / 'kill-during-commit').touch()
+        child, state = self.spawn(timeout=5)
+        self.assertEqual(state['state'], 'pending')
+        child.stdin.write(b'keep\n')
+        self.finish(child)
+        self.assertEqual(child.returncode, -signal.SIGKILL)
+        current = display.read_profile(self.home / '.config/core-desktop/display.json')
+        self.assertEqual(current['layout']['outputs'][0]['name'], 'HDMI-1')
+        with patch.dict(os.environ, self.env):
+            self.assertTrue(display.recover_abandoned('node', self.backend))
+        restored = display.read_profile(self.home / '.config/core-desktop/display.json')
+        self.assertEqual(restored, self.original)
+        self.assertEqual([o.name for o in self.backend.probe().active], ['eDP-1'])
+        self.assertFalse((self.runtime / 'core-display/pending.json').exists())
+
+    def test_save_failure_restores_old_layout_and_preferences(self):
+        (self.backend_dir / 'fail-save').touch()
+        child, _ = self.spawn(timeout=5)
+        child.stdin.write(b'keep\n')
+        result = self.finish(child)
+        self.assertEqual(result[-1]['state'], 'error')
+        restored = display.read_profile(self.home / '.config/core-desktop/display.json')
+        self.assertEqual(restored, self.original)
+        self.assertEqual([o.name for o in self.backend.probe().active], ['eDP-1'])
+        self.assertFalse((self.runtime / 'core-display/pending.json').exists())
+
+    def test_second_transaction_cannot_race_pending_change(self):
+        first, _ = self.spawn(timeout=3)
+        second, result = self.spawn(timeout=3)
+        self.assertEqual(result['state'], 'error')
+        self.finish(second)
+        self.assertEqual([o.name for o in self.backend.probe().active], ['HDMI-1'])
+        first.stdin.write(b'revert\n')
+        self.finish(first)
+        self.assert_reverted()
+
+    def test_gui_process_death_closes_pipe_and_restores_layout(self):
+        driver = subprocess.Popen([sys.executable, __file__, '--driver', str(self.backend_dir)],
+                                  stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                  env=self.env, start_new_session=True, bufsize=0)
+        self.children.append(driver)
+        ready, _, _ = select.select([driver.stdout], [], [], 5)
+        self.assertTrue(ready)
+        response = json.loads(driver.stdout.readline())
+        self.assertEqual(response['state'], 'pending')
+        driver.kill()
+        driver.wait(timeout=3)
+        deadline = time.monotonic() + 5
+        while time.monotonic() < deadline:
+            if ([o.name for o in self.backend.probe().active] == ['eDP-1']
+                    and not (self.runtime / 'core-display/pending.json').exists()):
+                break
+            time.sleep(0.05)
+        self.assert_reverted()
+
+
+def run_fixture():
+    def terminate(*_):
+        raise KeyboardInterrupt()
+    signal.signal(signal.SIGTERM, terminate)
