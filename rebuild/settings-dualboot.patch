diff --git a/tests/shared_display_fixtures.py b/tests/shared_display_fixtures.py
new file mode 100644
index 0000000..3d5ff7a
--- /dev/null
+++ b/tests/shared_display_fixtures.py
@@ -0,0 +1,154 @@
+"""Disposable display fixtures. No fixture invokes xrandr or touches a desktop."""
+import copy
+from dataclasses import asdict
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'runtime/usr/share/core-desktop'))
+import core_display as display
+
+
+def edid(byte):
+    return '\n'.join('\t\t' + byte * 16 for _ in range(8))
+
+
+QUERY = '''Screen 0: minimum 8 x 8, current 1920 x 1080, maximum 16384 x 16384
+eDP-1 connected primary 1920x1080+0+0 (normal left inverted right x axis y axis) 309mm x 174mm
+\tEDID:
+{edid0}
+\tBacklight: 400
+   1920x1080     60.00*+ 59.94
+   1600x900      60.00
+   1280x720      60.00
+HDMI-1 connected (normal left inverted right x axis y axis)
+\tEDID:
+{edid1}
+\tlink-status: Good
+   3840x2160     30.00
+   1920x1080     60.00+ 59.94 50.00
+   1280x720      60.00 50.00
+DP-1 disconnected (normal left inverted right x axis y axis)
+'''.format(edid0=edid('00'), edid1=edid('11'))
+
+VERBOSE = '''Screen 0: minimum 8 x 8, current 1920 x 1080, maximum 16384 x 16384
+eDP-1 connected primary 1920x1080+0+0 (0x1a) normal (normal left inverted right x axis y axis) 309mm x 174mm
+\tTransform: 1.000000 0.000000 0.000000
+\t           0.000000 1.000000 0.000000
+\t           0.000000 0.000000 1.000000
+\t          filter:
+HDMI-1 connected (normal left inverted right x axis y axis)
+\tTransform: 1.000000 0.000000 0.000000
+\t           0.000000 1.000000 0.000000
+\t           0.000000 0.000000 1.000000
+\t          filter:
+DP-1 disconnected (normal left inverted right x axis y axis)
+'''
+
+
+def initial():
+    result = display.parse_query(QUERY)
+    display.add_transforms(result, VERBOSE)
+    return result
+
+
+def requested(snapshot=None):
+    snapshot = snapshot or initial()
+    layout = dict(outputs=[dict(name='HDMI-1', mode='1920x1080', rate='60', x=0, y=0,
+                                rotation='normal', primary=True)],
+                  scale='1.25', preset='external', arrangement='right')
+    return display.make_profile('node', snapshot, layout)
+
+
+def decode_snapshot(value):
+    outputs = []
+    for item in value['outputs']:
+        item = dict(item)
+        item['modes'] = [display.Mode(**mode) for mode in item['modes']]
+        item['millimetres'] = tuple(item['millimetres'])
+        item['transform'] = tuple(item['transform'])
+        item['rotations'] = tuple(item['rotations'])
+        outputs.append(display.Output(**item))
+    return display.Snapshot(outputs, tuple(value['maximum']))
+
+
+class SimulatedBackend:
+    """Cross-process fake with an audit trail for rollback/lifecycle tests."""
+    def __init__(self, directory):
+        self.directory = Path(directory)
+        self.directory.mkdir(parents=True, exist_ok=True)
+        self.state_path = self.directory / 'state.json'
+        self.events_path = self.directory / 'events.jsonl'
+        self.scale_record = b'{"scale":1,"dpi":96}\n'
+        if not self.state_path.exists():
+            self.write(initial())
+
+    def event(self, name, **fields):
+        with self.events_path.open('a') as stream:
+            stream.write(json.dumps(dict(event=name, **fields)) + '\n')
+
+    def write(self, state):
+        display.atomic_write(self.state_path, json.dumps(asdict(state)))
+
+    def probe(self, transforms=False):
+        return decode_snapshot(json.loads(self.state_path.read_text()))
+
+    def capture_scale(self):
+        return 96.0
+
+    def apply(self, layout, snapshot=None):
+        state = self.probe()
+        display.validate_live_layout(layout, state)
+        self.event('apply', layout=layout)
+        enabled = {item['name']: item for item in layout['outputs']}
+        for output in state.outputs:
+            if output.name in enabled:
+                item = enabled[output.name]
+                mode = output.find_mode(item['mode'])
+                output.mode, output.rate = item['mode'], item['rate']
+                output.width, output.height = (mode.height, mode.width) if item['rotation'] in ('left', 'right') else (mode.width, mode.height)
+                output.x, output.y = item['x'], item['y']
+                output.rotation, output.primary = item['rotation'], item['primary']
+            else:
+                output.width = output.height = 0
+                output.mode = output.rate = None
+                output.primary = False
+        self.write(state)
+        if (self.directory / 'fail-apply').exists():
+            raise display.DisplayError('A simulated hardware apply failed after a partial change.')
+
+    def set_scale(self, scale):
+        self.event('scale', scale=scale)
+
+    def restore_scale(self, dpi):
+        self.event('restore-scale', dpi=dpi)
+
+    def restore(self, before):
+        self.event('restore', layout=display.layout_from_snapshot(before))
+        current = self.probe()
+        for output in current.outputs:
+            old = before.find(output.name)
+            if old is not None and old.active and output.connected:
+                for attr in ('mode', 'rate', 'width', 'height', 'x', 'y', 'rotation', 'primary'):
+                    setattr(output, attr, getattr(old, attr))
+            else:
+                output.width = output.height = 0
+                output.mode = output.rate = None
+                output.primary = False
+        if not current.active:
+            monitor = next(o for o in current.connected if o.modes)
+            mode = monitor.preferred_mode()
+            monitor.mode, monitor.rate = mode.name, mode.rates[0]
+            monitor.width, monitor.height = mode.width, mode.height
+            monitor.primary = True
+        self.write(current)
+
+    def fallback(self, snapshot=None):
+        self.event('fallback')
+        self.restore(initial())
+
+
+def events(directory):
+    path = Path(directory) / 'events.jsonl'
+    return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []
diff --git a/tests/shared_display_x11_smoke.py b/tests/shared_display_x11_smoke.py
new file mode 100644
index 0000000..882fa83
--- /dev/null
+++ b/tests/shared_display_x11_smoke.py
@@ -0,0 +1,215 @@
+#!/usr/bin/python3
+"""Exercise real RandR transactions only inside a newly owned Xvfb server.
+
+This never connects to the caller's DISPLAY. Xvfb's fixed virtual video mode
+does not establish compatibility with physical monitors or capture devices.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import secrets
+import select
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+
+def load(args):
+    sys.path.insert(0, str(Path(args.module_dir).resolve()))
+    import core_display
+    core_display.SCALE_HELPER = str(Path(args.scale_helper).resolve())
+    return core_display
+
+
+def event(process, timeout=5):
+    ready, _, _ = select.select([process.stdout], [], [], timeout)
+    if not ready:
+        raise RuntimeError('The transaction worker did not respond.')
+    raw = process.stdout.readline()
+    if not raw:
+        error = process.stderr.read().decode(errors='replace')
+        raise RuntimeError('The transaction worker stopped: ' + error[-1500:])
+    return json.loads(raw)
+
+
+def signature(snapshot):
+    return [(o.name, o.mode, o.rate, o.x, o.y, o.rotation, o.primary) for o in snapshot.active]
+
+
+def run(args):
+    core = load(args)
+    for tool in ('Xvfb', 'xauth', 'xrandr', 'xrdb'):
+        if shutil.which(tool) is None:
+            raise RuntimeError('Missing isolated X11 test dependency: ' + tool)
+    parent = Path(args.output).resolve()
+    parent.mkdir(parents=True, exist_ok=True)
+    work = Path(tempfile.mkdtemp(prefix='native-x11-', dir=parent))
+    home, runtime = work / 'home', work / 'runtime'
+    home.mkdir(mode=0o700)
+    runtime.mkdir(mode=0o700)
+    auth = work / 'Xauthority'
+    auth.touch(mode=0o600)
+    number = next(n for n in range(180, 300) if not Path('/tmp/.X11-unix/X' + str(n)).exists()
+                  and not Path('/tmp/.X' + str(n) + '-lock').exists())
+    subprocess.run(['/usr/bin/xauth', '-f', str(auth)],
+                   input='add :' + str(number) + ' MIT-MAGIC-COOKIE-1 ' + secrets.token_hex(16) + '\n',
+                   text=True, capture_output=True, check=True)
+    env = dict(os.environ, DISPLAY=':' + str(number), XAUTHORITY=str(auth), HOME=str(home),
+               XDG_RUNTIME_DIR=str(runtime), LC_ALL='C', LANG='C')
+    logfile = (work / 'xvfb.log').open('wb')
+    server = subprocess.Popen(['/usr/bin/Xvfb', ':' + str(number), '-screen', '0', '1280x800x24',
+                               '-nolisten', 'tcp', '-noreset', '-auth', str(auth)],
+                              stdin=subprocess.DEVNULL, stdout=logfile, stderr=subprocess.STDOUT)
+    children = []
+    report = dict(display=':' + str(number), isolated=True, cases=[],
+                  source_sha256=hashlib.sha256(Path(core.__file__).read_bytes()).hexdigest(),
+                  scale_sha256=hashlib.sha256(Path(core.SCALE_HELPER).read_bytes()).hexdigest())
+    previous_env = os.environ.copy()
+    try:
+        os.environ.update(env)
+        for _ in range(50):
+            if server.poll() is not None:
+                raise RuntimeError('The private X server stopped.')
+            ready = subprocess.run(['/usr/bin/xrandr', '--query', '--props'], env=env,
+                                   capture_output=True, text=True, timeout=3)
+            if ready.returncode == 0:
+                break
+            time.sleep(0.1)
+        else:
+            raise RuntimeError('The private X server did not become ready.')
+        (work / 'initial-query.txt').write_text(ready.stdout)
+        def traced_run(command, **kwargs):
+            result = subprocess.run(command, **kwargs)
+            with (work / 'commands.jsonl').open('a') as trace:
+                trace.write(json.dumps(dict(args=command, status=result.returncode, stderr=result.stderr)) + '\n')
+            return result
+        backend = core.Backend(traced_run)
+        before = backend.probe(transforms=True)
+        old_dpi = backend.capture_scale()
+        backend.scale_record = backend.capture_runtime_scale()
+        layout = core.layout_from_snapshot(before, '1.25')
+        backend.apply(layout, before)
+        assert core.active_matches(layout, backend.probe()), 'Native RandR did not apply the requested state.'
+        backend.set_scale('1.25')
+        assert abs(backend.capture_scale() - 120) < 0.1, 'Native xrdb did not apply 125% scale.'
+        backend.restore(before)
+        backend.restore_scale(old_dpi)
+        assert signature(backend.probe()) == signature(before), 'Native rollback changed the original state.'
+        report['cases'].append('native apply / primary / DPI / exact rollback')
+
+        def worker(scale, timeout=2):
+            snapshot = backend.probe(transforms=True)
+            current = core.layout_from_snapshot(snapshot, scale)
+            profile = core.make_profile('node', snapshot, current)
+            command = [sys.executable, str(Path(__file__).resolve()), '--worker', '--module-dir',
+                       args.module_dir, '--scale-helper', args.scale_helper, '--timeout', str(timeout)]
+            child = subprocess.Popen(command, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                     stderr=subprocess.PIPE, start_new_session=True, bufsize=0)
+            children.append(child)
+            child.stdin.write((json.dumps(profile) + '\n').encode())
+            child.stdin.flush()
+            value = event(child)
+            assert value['state'] == 'pending', value
+            return child
+
+        baseline = backend.probe()
+        baseline_dpi = backend.capture_scale()
+        child = worker('1.25', timeout=0.5)
+        value = event(child)
+        child.wait(timeout=8)
+        assert value['state'] == 'reverted', value
+        assert signature(backend.probe()) == signature(baseline)
+        assert abs(backend.capture_scale() - baseline_dpi) < 0.1
+        assert not core.profile_path('node').exists()
+        report['cases'].append('native timeout restores layout/DPI and does not save preferences')
+
+        child = worker('1.25')
+        child.stdin.write(b'keep\n')
+        value = event(child)
+        child.wait(timeout=8)
+        assert value['state'] == 'kept', value
+        saved = core.profile_path('node').read_bytes()
+        assert core.load_saved('node')['layout']['scale'] == '1.25'
+        kept = backend.probe()
+        kept_dpi = backend.capture_scale()
+        report['cases'].append('native Keep saves a validated user profile')
+
+        child = worker('1')
+        child.stdin.close()
+        value = event(child)
+        child.wait(timeout=8)
+        assert value['state'] == 'reverted', value
+        assert signature(backend.probe()) == signature(kept)
+        assert abs(backend.capture_scale() - kept_dpi) < 0.1
+        assert core.profile_path('node').read_bytes() == saved
+        report['cases'].append('native GUI pipe EOF restores confirmed state')
+
+        child = worker('1', timeout=5)
+        child.kill()
+        child.wait(timeout=5)
+        assert core.recover_abandoned('node', backend)
+        assert signature(backend.probe()) == signature(kept)
+        assert abs(backend.capture_scale() - kept_dpi) < 0.1
+        assert core.profile_path('node').read_bytes() == saved
+        report['cases'].append('native killed worker recovery from RAM journal')
+        report['result'] = 'PASS'
+        report['limitations'] = ['Xvfb exposes one fixed virtual mode; physical resolution switches, multiple outputs, hotplug and capture devices still need VM/hardware acceptance.']
+        (work / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
+        print(json.dumps(dict(work=str(work), **report), indent=2), flush=True)
+        return 0
+    except Exception as exc:
+        report['result'], report['error'] = 'FAIL', str(exc)
+        (work / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
+        print(json.dumps(dict(work=str(work), **report), indent=2), flush=True)
+        return 1
+    finally:
+        for child in children:
+            if child.poll() is None:
+                child.terminate()
+            try:
+                child.wait(timeout=4)
+            except subprocess.TimeoutExpired:
+                child.kill()
+                child.wait()
+            for stream in (child.stdin, child.stdout, child.stderr):
+                try:
+                    stream.close()
+                except (AttributeError, OSError):
+                    pass
+        server.terminate()
+        try:
+            server.wait(timeout=3)
+        except subprocess.TimeoutExpired:
+            server.kill()
+            server.wait()
+        logfile.close()
+        auth.unlink(missing_ok=True)
+        os.environ.clear()
+        os.environ.update(previous_env)
+
+
+def main():
+    base = Path(__file__).resolve().parents[1]
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--module-dir', default=str(base / 'runtime/usr/share/core-desktop'))
+    parser.add_argument('--scale-helper', default=str(base / 'runtime/usr/local/bin/core-display-scale'))
+    parser.add_argument('--output', default=str(base / 'display-x11-qa'))
+    parser.add_argument('--worker', action='store_true')
+    parser.add_argument('--timeout', type=float, default=15)
+    args = parser.parse_args()
+    if args.worker:
+        core = load(args)
+        def terminate(*_):
+            raise KeyboardInterrupt()
+        signal.signal(signal.SIGTERM, terminate)
+        return core.transaction('node', timeout=args.timeout)
+    return run(args)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
