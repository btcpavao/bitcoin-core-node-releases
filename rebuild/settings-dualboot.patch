diff --git a/app/device_profile_data.py b/app/device_profile_data.py
new file mode 100644
index 0000000..4da0d9c
--- /dev/null
+++ b/app/device_profile_data.py
@@ -0,0 +1,138 @@
+"""Portable, strictly allowlisted display/keyboard/pointer preferences.
+
+This is not a home-directory backup. No clock timestamp, network credential,
+wallet data, arbitrary filename or executable command can occur in the schema.
+The same file format is used by Node and Vault; application remains local.
+"""
+import importlib
+import json
+import math
+import os
+from pathlib import Path
+import stat
+import sys
+
+MAX_BYTES = 131072
+KIND = 'bitcoin-core-device-settings'
+
+
+class ProfileError(ValueError):
+    pass
+
+
+def require(value, message='Please choose a valid device-settings profile.'):
+    if not value:
+        raise ProfileError(message)
+
+
+def backends(product):
+    require(product in ('node', 'vault'))
+    return (importlib.import_module('desktop_input' if product == 'node' else 'vault_input'),
+            importlib.import_module('pointer_control' if product == 'node' else 'vault_pointer'))
+
+
+def display_backend(product):
+    directory = Path('/usr/share/core-desktop')
+    if not directory.is_dir():
+        own = Path(__file__).resolve()
+        directory = (own.parents[1] / 'runtime/usr/share/core-desktop' if product == 'node'
+                     else own.parents[3] / 'share/core-desktop')
+    if str(directory) not in sys.path:
+        sys.path.insert(0, str(directory))
+    return importlib.import_module('core_display')
+
+
+def validate_pointer(value):
+    require(isinstance(value, dict) and set(value) == {'schema', 'devices'})
+    require(type(value['schema']) is int and value['schema'] == 1)
+    devices = value['devices']
+    require(isinstance(devices, dict) and len(devices) <= 32)
+    for name, speed in devices.items():
+        require(isinstance(name, str) and 1 <= len(name) <= 200
+                and not any(ord(c) < 32 or ord(c) == 127 for c in name))
+        require(type(speed) in (int, float) and math.isfinite(speed) and -1 <= speed <= 1)
+    return {'schema': 1, 'devices': {name: round(float(speed), 2) for name, speed in devices.items()}}
+
+
+def validate(value, product):
+    require(isinstance(value, dict) and set(value) == {'kind', 'version', 'input', 'display'})
+    require(value['kind'] == KIND and type(value['version']) is int and value['version'] == 1)
+    data = value['input']
+    require(isinstance(data, dict) and set(data) == {'layout', 'preferences', 'pointer'})
+    inputs, _ = backends(product)
+    result = {'kind': KIND, 'version': 1, 'input': {
+        'layout': inputs.validate_layout(data['layout']),
+        'preferences': inputs.validate(data['preferences']),
+        'pointer': validate_pointer(data['pointer'])}, 'display': None}
+    if value['display'] is not None:
+        result['display'] = display_backend(product).validate_profile(value['display'])
+    return result
+
+
+def snapshot(product):
+    inputs, pointer = backends(product)
+    layout = inputs.read_system_layout() if product == 'node' else inputs.load_layout()
+    return validate({'kind': KIND, 'version': 1,
+        'input': {'layout': layout, 'preferences': inputs.load(),
+                  'pointer': {'schema': 1, 'devices': pointer.load_preferences()}},
+        'display': display_backend(product).load_saved(product)}, product)
+
+
+def read(path, product):
+    require(Path(path).is_absolute())
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, 'rb') as source:
+        info = os.fstat(source.fileno())
+        require(stat.S_ISREG(info.st_mode) and info.st_size <= MAX_BYTES)
+        raw = source.read(MAX_BYTES + 1)
+        require(len(raw) <= MAX_BYTES)
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            require(key not in result)
+            result[key] = value
+        return result
+    try:
+        data = json.loads(raw, object_pairs_hook=unique,
+                          parse_constant=lambda _: (_ for _ in ()).throw(ProfileError('Invalid number.')))
+        return validate(data, product)
+    except (ValueError, TypeError, UnicodeError):
+        raise ProfileError('Please choose a valid device-settings profile.') from None
+
+
+def write(path, value, product):
+    value = validate(value, product)
+    path = Path(path)
+    require(path.is_absolute())
+    raw = (json.dumps(value, sort_keys=True, indent=2) + '\n').encode()
+    require(len(raw) <= MAX_BYTES)
+    # A mistaken destination must never replace an existing wallet or backup.
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    try:
+        with os.fdopen(fd, 'wb') as target:
+            target.write(raw); target.flush(); os.fsync(target.fileno())
+    except Exception:
+        path.unlink(missing_ok=True)
+        raise
+
+
+def apply_input(value, product):
+    value = validate(value, product)
+    inputs, pointer = backends(product)
+    request = value['input']
+    if product == 'node':
+        from ui import admin
+        admin('keyboard-settings', request['layout'])
+        inputs.apply_keyboard(request['preferences']['keyboard'], layout=request['layout'])
+    else:
+        inputs.apply_local_layout(request['layout'], request['preferences']['keyboard'])
+    inputs.save(request['preferences'])
+    inputs.atomic(pointer.PREFS, (json.dumps(request['pointer'], sort_keys=True) + '\n').encode())
+    matched = 0
+    for device in pointer.get_devices():
+        name = device['name']
+        if name in request['pointer']['devices']:
+            pointer.set_speed(device['id'], request['pointer']['devices'][name]); matched += 1
+        if name in request['preferences']['devices']:
+            inputs.apply_device(device['id'], request['preferences']['devices'][name])
+    return {'ok': True, 'matching_pointer_devices': matched}
diff --git a/app/device_profiles.py b/app/device_profiles.py
new file mode 100644
index 0000000..211e63a
--- /dev/null
+++ b/app/device_profiles.py
@@ -0,0 +1,134 @@
+"""Reviewable USB device-preference transfer; display changes need their own confirmation."""
+from pathlib import Path
+from PySide6.QtCore import Qt, Slot
+from PySide6.QtWidgets import QDialog, QHBoxLayout, QLabel, QPushButton, QVBoxLayout
+import device_profile_data as profiles
+
+
+class DeviceProfilesDialog(QDialog):
+    def __init__(self, product, owner, initial_mode='export'):
+        super().__init__(owner)
+        self.product = product; self.owner = owner; self.profile = None; self.job = None
+        if product == 'node':
+            from ui import STYLE
+        else:
+            from vault_settings import STYLE
+        self.setStyleSheet(STYLE); self.setWindowTitle('Device Settings')
+        self.resize(700, 470)
+        box = QVBoxLayout(self)
+        heading = QLabel('Device Settings'); heading.setObjectName('Title'); box.addWidget(heading)
+        info = QLabel('Transfer keyboard, mouse and saved display preferences using a JSON file. Wallets, passwords, network settings and clock timestamps are excluded.')
+        info.setWordWrap(True); info.setObjectName('Muted'); box.addWidget(info)
+        note = QLabel('On Vault, imported preferences stay in RAM for this session.' if product == 'vault'
+                      else 'On the installed Node, imported input preferences are saved locally.')
+        note.setWordWrap(True); box.addWidget(note)
+        row = QHBoxLayout()
+        self.export_button = QPushButton('Export device settings…'); self.export_button.clicked.connect(self.export_file)
+        self.import_button = QPushButton('Open device settings…'); self.import_button.clicked.connect(self.open_file)
+        row.addWidget(self.export_button); row.addWidget(self.import_button); box.addLayout(row)
+        self.review = QLabel('Please open a profile to review its contents before applying it.')
+        self.review.setWordWrap(True); self.review.setTextFormat(Qt.PlainText); box.addWidget(self.review)
+        actions = QHBoxLayout()
+        self.apply = QPushButton('Apply input settings'); self.apply.setEnabled(False); self.apply.clicked.connect(self.apply_input)
+        self.displays = QPushButton('Review display settings'); self.displays.setEnabled(False); self.displays.clicked.connect(self.review_displays)
+        actions.addWidget(self.apply); actions.addWidget(self.displays); box.addLayout(actions)
+        self.feedback = QLabel(); self.feedback.setWordWrap(True); self.feedback.setTextFormat(Qt.PlainText)
+        box.addWidget(self.feedback); box.addStretch(1)
+        self.back = QPushButton('Back to Settings'); self.back.clicked.connect(self.reject); box.addWidget(self.back)
+        (self.import_button if initial_mode == 'import' else self.export_button).setFocus()
+
+    def choose(self, title, initial, saving=False):
+        if self.product == 'node':
+            from media_file_dialog import choose_media_file
+        else:
+            from vault_media_file_dialog import choose_media_file
+        return choose_media_file(self, title, initial, saving=saving,
+                                 name_filter='Device settings (*.json)')
+
+    def export_file(self):
+        if self.job is not None:
+            return
+        try:
+            value = profiles.snapshot(self.product)
+            path = self.choose('Export device settings', str(Path.home() / 'device-settings.json'), True)
+            if not path:
+                return
+            profiles.write(path, value, self.product)
+            self.feedback.setText('Device settings exported. Please keep the file on external media if you need it after this session.')
+        except FileExistsError:
+            self.feedback.setText('That file already exists. Please choose a new filename.')
+        except (OSError, ValueError, RuntimeError):
+            self.feedback.setText('Device settings could not be exported. Please choose a writable destination and check the current settings.')
+
+    def open_file(self):
+        if self.job is not None:
+            return
+        path = self.choose('Open device settings', '/media')
+        if not path:
+            return
+        try:
+            value = profiles.read(path, self.product)
+        except (OSError, ValueError, RuntimeError):
+            self.profile = None; self.apply.setEnabled(False); self.displays.setEnabled(False)
+            self.feedback.setText('This is not a valid supported device-settings profile. No changes were made.')
+            return
+        self.profile = value
+        data = value['input']
+        names = set(data['pointer']['devices']) | set(data['preferences']['devices'])
+        self.review.setText('Keyboard layout: ' + data['layout']['layout'] +
+            (' / ' + data['layout']['variant'] if data['layout']['variant'] else '') +
+            '\nSaved pointer devices: ' + str(len(names)) +
+            '\nDisplay profile: ' + ('available for review' if value['display'] else 'none saved') +
+            '\nInput preferences apply only to supported matching devices. Display settings are reviewed separately and require Keep changes confirmation.')
+        self.apply.setEnabled(True); self.displays.setEnabled(value['display'] is not None)
+        self.feedback.setText('Profile validated. Please choose which settings to apply.')
+
+    def apply_input(self):
+        if self.job is not None or self.profile is None:
+            return
+        if self.product == 'node':
+            from ui import Job
+        else:
+            from vault_settings import Job
+        self.feedback.setText('Applying local keyboard and pointer preferences…')
+        for control in (self.apply, self.displays, self.import_button, self.export_button, self.back):
+            control.setEnabled(False)
+        self.job = Job(lambda: profiles.apply_input(self.profile, self.product), self)
+        self.job.success.connect(self.applied); self.job.failure.connect(self.failed)
+        self.job.finished.connect(self.finished_job); self.job.start()
+
+    @Slot(object)
+    def applied(self, result):
+        self.feedback.setText('Input preferences applied. Display settings have not changed; use Review display settings to check and apply them.')
+
+    @Slot(str)
+    def failed(self, message):
+        self.feedback.setText('Some input settings could not be applied. Please reopen Keyboard and Mouse to check the current state. ' + message)
+
+    @Slot()
+    def finished_job(self):
+        job = self.job; self.job = None
+        for control in (self.apply, self.import_button, self.export_button, self.back):
+            control.setEnabled(True)
+        self.displays.setEnabled(self.profile is not None and self.profile['display'] is not None)
+        job.deleteLater()
+
+    def review_displays(self):
+        if self.profile is None or self.profile['display'] is None:
+            return
+        registry = getattr(self.owner, '_modeless_windows', {}) if self.product == 'node' else getattr(self.owner, '_settings_windows', {})
+        if registry.get('display_settings') is not None:
+            self.feedback.setText('Please close the existing Display Settings window before reviewing the imported display profile.')
+            self.owner.display_settings()
+            return
+        self.owner.display_settings(imported_profile=self.profile['display'])
+
+    def done(self, result):
+        if self.job is None:
+            super().done(result)
+
+    def closeEvent(self, event):
+        if self.job is not None:
+            event.ignore()
+        else:
+            super().closeEvent(event)
diff --git a/app/guide_content.py b/app/guide_content.py
index 82894cf..ec03716 100644
--- a/app/guide_content.py
+++ b/app/guide_content.py
@@ -2,7 +2,7 @@
 No file/network access is performed by this content module.
 """
 SECTIONS = {
-'Start here: Node & Vault': "<h2>Start here: Node &amp; Vault</h2>\n<p><b>Use Node to receive, prepare payments and broadcast. Use Vault to keep the signing keys offline and approve spending.</b> This walkthrough starts with your installed Node and a signing wallet created and backed up on Bitcoin Core Vault. The Vault Guide covers that first wallet and its separate Core/GPG passphrases.</p>\n<p>The online Node stores a <b>watch-only wallet</b>: public address information, labels and transaction history, without the private keys. A <b>PSBT</b> (Partially Signed Bitcoin Transaction) carries an unsigned payment and supporting information to Vault, and carries the signatures back. No signing wallet or signing secret needs to come online.</p>\n<h3>1. Install and connect Node</h3>\n<p>Boot the Node installation USB, choose the keyboard and target disk, and review the selection. <b>Installation erases that disk.</b> Please disconnect valuable backup drives before installing. After installation, restart without the installation USB. Use Network Status to connect to Wi-Fi, or connect an Ethernet cable.</p>\n<h3>2. Choose how to protect access to this computer</h3>\n<p>A watch-only wallet is stored persistently on Node. Someone using its unlocked desktop can inspect your financial history. Open <b>Settings → Login Password</b> to set an optional password for the next login. This prevents ordinary automatic access to the desktop; <b>it does not encrypt the disk or protect an already-open session</b>. Read Device privacy &amp; login before leaving the device unattended.</p>\n<h3>3. Choose block storage before downloading</h3>\n<p>Open Bitcoin Core. In its first-start window, choose the intended data location and whether to limit block storage. Pruning retains less old block data after validation. Choose a target that leaves space for chainstate, indexes and maintenance, not the entire free disk. See Storage &amp; pruning for a worked example. Import an existing trusted Node blockchain backup first if you intend to reuse one.</p>\n<h3>4. Export the public wallet from Vault</h3>\n<p>On offline Vault, select your signing wallet in Bitcoin Core and choose <b>File → Export watch-only wallet</b>. Save it as <b>watch-only.dat</b> in Private Workspace, then use Files to copy that public export to your transfer USB. You can also export directly to the transfer USB. If Vault asks about wallet metadata, read the warning before approving. The copy can contain address labels, notes and transaction history. Cancel leaves the file off the USB. <b>Do not bring the original signing wallet.dat, a decrypted signing backup, or the Core/GPG passphrases protecting the Vault signing backup to Node.</b></p>\n<h3>5. Restore the public copy into Node's Core</h3>\n<p>Connect the transfer USB. In Bitcoin Core choose <b>File → Restore Wallet</b>, select watch-only.dat and give the restored wallet a clear new name. You can select it from the USB sidebar or first copy it to PSBT Transfer Folder. If the public export itself is GPG-encrypted, use Decrypt Files and select the recovered public .dat in Private Workspace. Core creates a persistent public wallet on Node's disk; the transfer copy remains temporary if it is in RAM.</p>\n<h3>6. Finish synchronization and wallet scanning</h3>\n<p>Let Core validate the blockchain and scan the wallet's transactions. These are separate operations. Resolve warnings about missing pruned history; an unfinished scan is not a reliable balance. Check that you restored a watch-only wallet and that it corresponds to the intended Vault wallet and Bitcoin network.</p>\n<h3>7. Create a receiving address on Node</h3>\n<p>Select the watch-only wallet, open <b>Receive</b>, add a useful label and choose <b>Create new receiving address</b>. Share the resulting address or QR code with the sender. Independently confirm that the address belongs to the corresponding Vault wallet before a significant deposit. Address requests advance a wallet's address index, so compare the same address/index rather than assuming that two separately generated requests must match. Receiving bitcoin does not require Vault to be powered on.</p>\n<h3>8. Back up your online setup</h3>\n<p>Open <b>Settings → Backup and Restore</b>. Save the watch-only collection and Node configuration to separate backup media. Node configuration already includes supported Core settings. A blockchain backup is optional: it saves download/validation time after a disk failure or move to another computer, but is not a signing-wallet backup. Keep another copy and do not rely on a backup stored only on this computer's own disk.</p>\n<h3>9. Prepare an unsigned payment</h3>\n<p>With Core synchronized and the watch-only wallet selected, open <b>Send</b>. Enter the recipient's address and amount, choose the fee and review the payment. Use <b>Create Unsigned</b> to make a PSBT; this does not spend or broadcast anything. Save it as an identifiable .psbt file in PSBT Transfer Folder or directly on a writable transfer USB.</p>\n<h3>10. Move the PSBT to Vault</h3>\n<p>If saved in a RAM folder, use Files to copy it to the USB before restarting Node. Finish writes and eject/unmount the USB. On Vault, use Files to copy the PSBT into Private Workspace and open <b>Bitcoin Core → File → Load PSBT from file</b>. Use the matching signing wallet.</p>\n<h3>11. Review and sign offline</h3>\n<p>On offline Vault, compare every recipient address and amount with the original payment instructions received independently of Node. Check the fee and confirm that every <b>change</b> output belongs to your wallet before signing. Enter the Core wallet passphrase only there, when required, and select <b>Sign Tx</b>. Save the signed .psbt in Private Workspace, then copy it to the transfer USB with Files. You can also save the signed file directly to the transfer USB. Vault does not broadcast the transaction.</p>\n<h3>12. Bring the signed transaction back and broadcast</h3>\n<p>On Node, choose <b>File → Load PSBT from file</b> and open the returned signed PSBT. Check that it is the payment you approved and that signing is complete. Choose <b>Broadcast Tx</b> only when ready. The synchronized online Node sends it to Bitcoin peers. Watch the transaction in Core: broadcast is not a block confirmation, and a transaction ID alone is not proof of successful relay.</p>\n<h3>13. Save necessary files before restarting</h3>\n<p>The installed blockchain, restored watch-only wallets and Node settings persist. <b>Private Workspace and PSBT Transfer Folder do not:</b> they are RAM-only and clear at shutdown/restart or power loss. Save any unfinished PSBTs, recovered exports and notes you still need. Use normal Restart/Shut Down so Core can close cleanly.</p>\n<p>The remaining chapters explain these steps and the applications that support them. Keep the original signing-wallet backup and its redundant, separately stored secrets under your Vault recovery plan; Node's public backups do not replace them.</p>",
+'Start here: Node & Vault': "<h2>Start here: Node &amp; Vault</h2>\n<p><b>Use Node to receive, prepare payments and broadcast. Use Vault to keep the signing keys offline and approve spending.</b> This walkthrough starts with your installed Node and a signing wallet created and backed up on Bitcoin Core Vault. The Vault Guide covers that first wallet and its separate Core/GPG passphrases.</p>\n<p>The online Node stores a <b>watch-only wallet</b>: public address information, labels and transaction history, without the private keys. A <b>PSBT</b> (Partially Signed Bitcoin Transaction) carries an unsigned payment and supporting information to Vault, and carries the signatures back. No signing wallet or signing secret needs to come online.</p>\n<h3>1. Install and connect Node</h3>\n<p>Boot the Node installation USB and choose the keyboard and target disk. <b>Install to disk erases the selected physical disk.</b> <b>Advanced partitioning</b> selects an exact root partition or creates a layout in unallocated space, optionally reserving unformatted space for Vault. Advanced requires UEFI; existing partitions are never automatically shrunk or moved. Review which partitions will be formatted and which will be preserved. Please disconnect valuable backup drives before installing. After installation, restart without the installation USB. Use Settings → Network Connections to connect to Wi-Fi, or connect an Ethernet cable.</p>\n<h3>2. Choose how to protect access to this computer</h3>\n<p>A watch-only wallet is stored persistently on Node. Someone using its unlocked desktop can inspect your financial history. Open <b>Settings → Login Password</b> to set an optional password for the next login. This prevents ordinary automatic access to the desktop; <b>it does not encrypt the disk or protect an already-open session</b>. Read Device privacy &amp; login before leaving the device unattended.</p>\n<h3>3. Choose block storage before downloading</h3>\n<p>Open Bitcoin Core. In its first-start window, choose the intended data location and whether to limit block storage. Pruning retains less old block data after validation. Choose a target that leaves space for chainstate, indexes and maintenance, not the entire free disk. See Storage &amp; pruning for a worked example. Import an existing trusted Node blockchain backup first if you intend to reuse one.</p>\n<h3>4. Export the public wallet from Vault</h3>\n<p>On offline Vault, select your signing wallet in Bitcoin Core and choose <b>File → Export watch-only wallet</b>. Save it as <b>watch-only.dat</b> in Private Workspace, then use Files to copy that public export to your transfer USB. You can also export directly to the transfer USB. If Vault asks about wallet metadata, read the warning before approving. The copy can contain address labels, notes and transaction history. Cancel leaves the file off the USB. <b>Do not bring the original signing wallet.dat, a decrypted signing backup, or the Core/GPG passphrases protecting the Vault signing backup to Node.</b></p>\n<h3>5. Restore the public copy into Node's Core</h3>\n<p>Connect the transfer USB. In Bitcoin Core choose <b>File → Restore Wallet</b>, select watch-only.dat and give the restored wallet a clear new name. You can select it from the USB sidebar or first copy it to PSBT Transfer Folder. If the public export itself is GPG-encrypted, use Decrypt Files and select the recovered public .dat in Private Workspace. Core creates a persistent public wallet on Node's disk; the transfer copy remains temporary if it is in RAM.</p>\n<h3>6. Finish synchronization and wallet scanning</h3>\n<p>Let Core validate the blockchain and scan the wallet's transactions. These are separate operations. Resolve warnings about missing pruned history; an unfinished scan is not a reliable balance. Check that you restored a watch-only wallet and that it corresponds to the intended Vault wallet and Bitcoin network.</p>\n<h3>7. Create a receiving address on Node</h3>\n<p>Select the watch-only wallet, open <b>Receive</b>, add a useful label and choose <b>Create new receiving address</b>. Share the resulting address or QR code with the sender. Independently confirm that the address belongs to the corresponding Vault wallet before a significant deposit. Address requests advance a wallet's address index, so compare the same address/index rather than assuming that two separately generated requests must match. Receiving bitcoin does not require Vault to be powered on.</p>\n<h3>8. Back up your online setup</h3>\n<p>Open <b>Settings → Backup and Restore</b>. Save the watch-only collection and Node configuration to separate backup media. Node configuration already includes supported Core settings. A blockchain backup is optional: it saves download/validation time after a disk failure or move to another computer, but is not a signing-wallet backup. Keep another copy and do not rely on a backup stored only on this computer's own disk.</p>\n<h3>9. Prepare an unsigned payment</h3>\n<p>With Core synchronized and the watch-only wallet selected, open <b>Send</b>. Enter the recipient's address and amount, choose the fee and review the payment. Use <b>Create Unsigned</b> to make a PSBT; this does not spend or broadcast anything. Save it as an identifiable .psbt file in PSBT Transfer Folder or directly on a writable transfer USB.</p>\n<h3>10. Move the PSBT to Vault</h3>\n<p>If saved in a RAM folder, use Files to copy it to the USB before restarting Node. Finish writes and eject/unmount the USB. On Vault, use Files to copy the PSBT into Private Workspace and open <b>Bitcoin Core → File → Load PSBT from file</b>. Use the matching signing wallet.</p>\n<h3>11. Review and sign offline</h3>\n<p>On offline Vault, compare every recipient address and amount with the original payment instructions received independently of Node. Check the fee and confirm that every <b>change</b> output belongs to your wallet before signing. Enter the Core wallet passphrase only there, when required, and select <b>Sign Tx</b>. Save the signed .psbt in Private Workspace, then copy it to the transfer USB with Files. You can also save the signed file directly to the transfer USB. Vault does not broadcast the transaction.</p>\n<h3>12. Bring the signed transaction back and broadcast</h3>\n<p>On Node, choose <b>File → Load PSBT from file</b> and open the returned signed PSBT. Check that it is the payment you approved and that signing is complete. Choose <b>Broadcast Tx</b> only when ready. The synchronized online Node sends it to Bitcoin peers. Watch the transaction in Core: broadcast is not a block confirmation, and a transaction ID alone is not proof of successful relay.</p>\n<h3>13. Save necessary files before restarting</h3>\n<p>The installed blockchain, restored watch-only wallets and Node settings persist. <b>Private Workspace and PSBT Transfer Folder do not:</b> they are RAM-only and clear at shutdown/restart or power loss. Save any unfinished PSBTs, recovered exports and notes you still need. Use normal Restart/Shut Down so Core can close cleanly.</p>\n<p>The remaining chapters explain these steps and the applications that support them. Keep the original signing-wallet backup and its redundant, separately stored secrets under your Vault recovery plan; Node's public backups do not replace them.</p>",
 'Device privacy & login': "<h2>Device privacy &amp; login</h2>\n<p><b>Watch-only does not mean publicly readable.</b> It means the wallet lacks private spending keys. The public descriptors, address book, balances and transaction history stored on this Node can still reveal your finances.</p>\n<h3>What someone with access can see</h3>\n<p>Someone at an unlocked Node desktop can open Core and inspect loaded wallets. Closing a wallet window, stopping Core or restarting does not erase the persistent watch-only database. A person who can read the disk directly may copy the database and examine it on another computer. Screenshots, diagnostic output, watch-only exports and unencrypted wallet collections can reveal similar information.</p>\n<p>Without the Vault signing keys, the watch-only copy cannot independently sign a payment. However, a compromised online computer can propose false recipients, amounts or change outputs, or show a misleading receiving address. Independent checks on Vault remain part of the workflow.</p>\n<h3>Optional desktop login password</h3>\n<ol><li>Open <b>Settings → Login Password</b>.</li><li>Enter and repeat a password, then choose <b>Set password</b>. Choose a secret that is practical to use and not easily guessed. A random KeePassXC phrase is one option.</li><li>At the next start or restart, enter it on the Bitcoin Core Node login screen and press Enter. The username is fixed; you do not create another account.</li><li>Enter the current login password to use <b>Change password</b> or <b>Remove password</b>. Removing it enables automatic login at the next start.</li></ol>\n<p>These settings do not lock the current session. Anyone using the unlocked desktop can still open wallets and use its built-in controls. Shut down normally before leaving an unattended device in a place where others can use it. The current session must not be treated as protected just because you set a password.</p>\n<p><b>This login password is not disk encryption.</b> It provides an ordinary login barrier, not protection against booting another operating system, removing the disk, an administrator or a compromised running system. Keep physical access controlled. The installer does not add full-disk encryption. Encrypting an exported backup protects that export only, not Core's active watch-only database.</p>\n<h3>Different passwords have different jobs</h3>\n<p>The login password is for entering this Node desktop, not for each routine operation. Built-in backups, restores, updates and settings retain their confirmations but do not repeatedly request it. A GPG passphrase opens a particular encrypted backup. The Core signing-wallet passphrase belongs on offline Vault. Do not reuse the Vault secrets as the Node login password. The Node desktop account has no general sudo access. Its built-in controls run only the privileged operations approved for the active desktop.</p>\n<p>The Node configuration backup intentionally excludes the login password and account identity. Set a new login password on a replacement computer. Back up public wallet data privately; keep any encryption passphrase separately recoverable. Treat this as a dedicated Node rather than a computer for opening unrelated attachments, browsing or installing arbitrary software.</p>",
 'Storage & pruning': "<h2>Storage &amp; pruning</h2>\n<p><b>Choose how much old block history you keep, not how much checking Core performs.</b> An archival node retains the historical blocks. A pruned node validates blocks under the same rules, then removes older block and undo files to stay near a storage target. Pruning reduces retained storage; it does not eliminate the initial download and validation work.</p>\n<h3>Before opening Core for the first time</h3>\n<p>Home shows free space on the configured blockchain drive. Select <b>Suggested pruning target</b> to see the estimate. With 100 GB free on mainnet, Node allows 25 GB for chainstate, indexes and growth and leaves 15 GB free. This gives a suggested 60 GB block storage limit. Choose the limit yourself in the Bitcoin Core first-start window. After a blockchain import, the saved pruning configuration applies.</p>\n<h3>What the storage bar measures</h3>\n<p>Home's <b>Blockchain storage</b> bar shows percentage <b>full</b> and remaining usable space for blockchain data. In <b>Settings → Bitcoin Core Status</b>, use <b>Show blockchain storage on Home</b> to show or hide this bar. Its capacity is <b>allocated blocks, chainstate and indexes + free space available to Core</b>. It excludes space already occupied by Debian, installed programs, wallets, other files and filesystem reservations.</p>\n<p>For example, 30 GB used by blockchain data plus 60 GB free gives 90 GB capacity and <b>33.3% full</b>. This is not a separate reserved partition. Saving unrelated files or installing updates can reduce the available space. The usage estimate refreshes periodically; it is not a promise about how large the blockchain will be when synchronization finishes.</p>\n<h3>Set the target in Bitcoin Core</h3>\n<ol><li>Read the free/capacity figures for the actual disk where Core stores its data, not the capacity printed on the computer's packaging.</li><li>In Core's first-start storage window, or later under <b>Bitcoin Core → Settings → Options</b>, enable the option to limit/prune block storage and enter the intended target.</li><li>Use the unit displayed beside that field. Apply the setting and restart Core if it asks.</li><li>Monitor the storage bar during synchronization and afterwards. Leave free space for database growth and maintenance rather than aiming for 100% full.</li></ol>\n<h3>A practical budget</h3>\n<p><b>Block-file target ≤ usable blockchain capacity − chainstate/index allowance − free-space reserve.</b> Chainstate is Core's database of currently unspent outputs; it remains needed even after old blocks are deleted. Indexes help Core find its data. These are not all controlled by the block pruning target.</p>\n<p><b>Illustrative example, not a measurement of today's chainstate:</b> suppose the bar gives 90 GB of usable capacity. Allow 20 GB for chainstate and related indexes and leave another 20 GB free. That leaves a ceiling of 50 GB for retained block files. Choosing less, such as 40 GB, adds room. Replace those allowances with the actual usage and expected growth of your Node. An allowance that is adequate now may be too small later.</p>\n<p>Home and the Bitcoin Core pruning field display decimal GB. Each GB is 1,000,000,000 bytes. The advanced <b>prune</b> setting in bitcoin.conf uses MiB. A target of 40 GB corresponds to approximately 38,147 MiB.</p>\n<p>A larger target retains more recent history and gives more room for wallet rescans. It does not guarantee a fixed number of days or months: block sizes and transaction activity vary. A smaller target suits a smaller disk but requires more care with old or rarely opened wallets. No disk-size recommendation is permanent.</p>\n<h3>Plan watch-only imports before old history disappears</h3>\n<p>Restore your public wallet early and keep it loaded while Core synchronizes and prunes. A <b>rescan</b> looks through older blocks for that wallet's transactions. If needed blocks have already been removed, Core cannot reconstruct the missing history from a public descriptor alone. A pruned backup contains only retained blocks; copying it cannot restore blocks already deleted.</p>\n<p>For an old wallet or one left unloaded for a long time, recover a trusted copy with the needed history or use an archival node/re-download as required by Core. Do not invent a newer wallet creation date just to dismiss a warning. Wait until validation and wallet scanning have finished before trusting a balance.</p>\n<h3>Changing your choice later</h3>\n<p>Reducing the target may delete more old blocks. Increasing it retains more future blocks but does not automatically fetch all previously pruned history. Disabling pruning to return to archival operation can require downloading and rebuilding the complete history. Also leave extra temporary space when importing a blockchain backup: the current copy is kept until the incoming copy passes its restore checks.</p>\n<p>Technical source: Bitcoin Core's own <b>-prune</b> help in src/init.cpp and the pruning tests in test/functional/feature_pruning.py (github.com/bitcoin/bitcoin). The Node capacity formula is described above; it does not change Core's pruning rules.</p>",
 'Bitcoin Core': "<h2>Bitcoin Core</h2>\n<p>Bitcoin Core is the application that validates the blockchain, stores the public wallet, creates receiving addresses, prepares unsigned PSBTs and broadcasts the transactions signed on Vault. Use its ordinary wallet menus for those jobs; Node's Home and Settings provide the surrounding system tools.</p>\n<h3>Start and control Core</h3>\n<p>Open <b>Bitcoin Core</b> on Home to start it or return to its window. Use the wallet selector when more than one wallet is open. <b>File → Open Wallet</b> opens an existing wallet, and <b>File → Close Wallet</b> unloads one without deleting its database. Closing a window and ending the Core process are not always the same operation; use <b>File → Exit</b> or the Node Core-status controls to stop it cleanly.</p>\n<p>The indicator beside the clock describes <b>Bitcoin peer connections</b>, not merely Wi-Fi association. It opens details and controls. Pause sync temporarily disconnects peers; Resume sync reconnects. Stop Bitcoin Core closes Core so it can finish saving. Restart there restarts Core, not this computer.</p>\n<h3>What the Home status area means</h3>\n<p>The text and visible meters are centered between the launchers and the Debian logo. The upper bar fills yellow as Core validates the blockchain and turns solid green when the blockchain is synchronized. The lower meter shows blockchain storage percentage full and available capacity. A stopped/error message occupies the same centered area without empty bars. A changing percentage is not a promised finishing time.</p>\n<h3>Keep signing separate</h3>\n<p>The intended Node/Vault setup uses only public watch-only wallets here. Creating a signing wallet in online Core is possible, but it is a different arrangement: its private keys would be on the online device. Do not restore the Vault signing database here merely to make a PSBT easier to use. Node's Watch-only wallets backup intentionally skips signing wallets.</p>\n<h3>Delete a local wallet deliberately</h3>\n<p>Open <b>Wallets</b> on Home. Each open wallet shows its type as reported by Bitcoin Core. A watch-only wallet holds public data. A wallet with private keys enabled can hold signing keys on this computer. An external signer wallet uses a separate signing device. A closed wallet displays Unknown until you open it. Select a watch-only wallet and choose <b>Watch-only details</b> for its balances, addresses and history.</p><p>To remove a local wallet, first keep any backup you need, especially if its keys can spend bitcoin. Select its row, or Ctrl-click several. Choose <b>Secure Delete…</b>, check the names, then confirm with the red <b>Secure Delete</b> button. Node unloads the wallets, clears their startup entries and overwrites their files with three random passes followed by one zero pass. Core may briefly restart for offline maintenance. SSD wear levelling, snapshots and existing backups can retain copies.</p>\n<p>Deletion and overwriting are best effort, especially on SSDs and USB flash. Older copies or filesystem history may remain. Deleting a watch-only copy does not delete Bitcoin or the offline signing wallet; deleting the only signing wallet without a usable backup can lose access to funds. Keep the distinction explicit.</p>",
