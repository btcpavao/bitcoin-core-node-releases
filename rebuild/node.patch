+"""Exercise the two file deletion modes and Finder data/metadata transport formats."""
+import os
+from pathlib import Path
+import plistlib
+import struct
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'app'))
+import file_erase
+from text_clipping import ClippingError, read_clipping
+
+ADDRESS = 'bc1qexampleaddress0123456789'
+
+
+def resource(kind, data):
+    content = struct.pack('>I', len(data)) + data
+    type_list = struct.pack('>H4sHH', 0, kind, 0, 10)
+    type_list += struct.pack('>hHII', 256, 65535, 0, 0)
+    resource_map = bytes(24) + struct.pack('>HH', 28, 28 + len(type_list)) + type_list
+    return struct.pack('>4I', 16, 16 + len(content), len(content), len(resource_map)) + content + resource_map
+
+
+def apple_double(blob):
+    return struct.pack('>II16xHH', 0x00051607, 0x00020000, 1, 0)[:-2] + struct.pack('>III', 2, 38, len(blob)) + blob
+
+
+class TextClippings(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.path = Path(temp.name)/'USB address.textClipping'
+
+    def test_finder_plists_exact_text(self):
+        text = ADDRESS + '\nČć & <text>\n'
+        for fmt in (plistlib.FMT_BINARY, plistlib.FMT_XML):
+            for value in (text, text.encode()):
+                self.path.write_bytes(plistlib.dumps({'UTI-Data':{'public.utf8-plain-text':value, 'public.html':'ignored'}}, fmt=fmt))
+                self.assertEqual(read_clipping(self.path), text)
+        for codec in ('utf-16-be', 'utf-16-le', 'utf-16'):
+            self.path.write_bytes(plistlib.dumps({'UTI-Data':{'public.utf16-plain-text':text.encode(codec)}}))
+            self.assertEqual(read_clipping(self.path), text)
+
+    def test_finder_appledouble_and_resource_xattr(self):
+        self.path.touch()
+        side = self.path.with_name('._' + self.path.name)
+        for kind, encoding in ((b'utxt','utf-16-be'), (b'ut16','utf-16'), (b'utf8','utf-8'), (b'TEXT','mac_roman')):
+            fork = resource(kind, ADDRESS.encode(encoding))
+            side.write_bytes(apple_double(fork))
+            self.assertEqual(read_clipping(self.path), ADDRESS)
+        side.unlink()
+        with patch('os.getxattr', return_value=fork):
+            self.assertEqual(read_clipping(self.path), ADDRESS)
+
+    def test_unusable_clipping_has_no_automatic_fallback_to_other_content(self):
+        for data in (b'', b'garbage', b'bplist00'+bytes(32), plistlib.dumps({'UTI-Data':{'public.html':ADDRESS}})):
+            self.path.write_bytes(data)
+            with self.assertRaises(ClippingError):
+                read_clipping(self.path)
+        self.path.with_name('._' + self.path.name).write_bytes(apple_double(b'x'*28))
+        with self.assertRaises(ClippingError):
+            read_clipping(self.path)
+
+    def test_sidecar_link_and_oversize_refused(self):
+        self.path.touch()
+        side = self.path.with_name('._' + self.path.name)
+        side.symlink_to(self.path)
+        with self.assertRaises(OSError):
+            read_clipping(self.path)
+        with self.path.open('wb') as stream:
+            stream.truncate(3_000_000)
+        with self.assertRaises(ClippingError):
+            read_clipping(self.path)
+
+
+class FilesDeletion(unittest.TestCase):
+    def test_quick_unlinks_only_secure_finishes_with_zeros(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            for mode in ('quick','secure'):
+                p = Path(tmp)/'normal file'
+                data = b'selected item'*800
+                p.write_bytes(data)
+                with p.open('rb') as held, file_erase.build_plan([str(p)], check_overwrite=mode=='secure') as plan:
+                    with patch.object(file_erase, '_run_shred', wraps=file_erase._run_shred) as shred:
+                        result = file_erase.erase(plan, mode=mode)
+                        self.assertEqual(result.status, 'completed', result.message)
+                        self.assertEqual(shred.call_count, int(mode=='secure'))
+                    self.assertFalse(p.exists())
+                    self.assertEqual(held.read(), data if mode=='quick' else bytes(len(data)))
+
+    def test_selected_links_do_not_overwrite_target(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            target = Path(tmp)/'original'
+            target.write_bytes(b'keep')
+            link = Path(tmp)/'link'
+            link.symlink_to(target)
+            with file_erase.build_plan([str(link)]) as plan:
+                result=file_erase.erase(plan, mode='secure')
+            self.assertEqual(result.status,'completed')
+            self.assertFalse(link.is_symlink())
+            self.assertEqual(target.read_bytes(),b'keep')
+
+    def test_hard_link_preflight_refuses_content_overwrite(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            p = Path(tmp)/'selected'
+            p.write_text('keep')
+            other = Path(tmp)/'also'
+            os.link(p, other)
+            with self.assertRaises(file_erase.PlanError):
+                file_erase.build_plan([str(p)])
+            with file_erase.build_plan([str(p)], check_overwrite=False) as plan:
+                self.assertEqual(file_erase.erase(plan, mode='quick').status, 'completed')
+            self.assertEqual(other.read_text(),'keep')
+
+    def test_core_files_use_wallets_manager(self):
+        from file_delete_ui import node_paths
+        with patch('os.geteuid', return_value=1000):
+            for path in ('/run/core-node-files/Core/wallets/test','/var/lib/bitcoin-core-node/data','/','/var/lib/bitcoin-core-node'):
+                with self.assertRaisesRegex(ValueError, 'Wallets'):
+                    node_paths([path])
+            self.assertEqual(node_paths(['/media/node/USB/receipt.txt']), ['/media/node/USB/receipt.txt'])
