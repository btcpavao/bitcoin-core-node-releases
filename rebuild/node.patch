+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT / 'app'))
+import desktop_input
+
+
+class GreeterNumLock(unittest.TestCase):
+    def test_saved_preference_and_default_follow_the_desktop(self):
+        with tempfile.TemporaryDirectory() as home:
+            env = dict(os.environ, HOME=home)
+            command = [sys.executable, '-Es', str(ROOT / 'app/desktop_input.py'), '--startup-numlock']
+            prefs = Path(home) / '.config/bitcoin-core-node/input.json'
+            prefs.parent.mkdir(parents=True)
+            for saved, expected in ((None, 0), (False, 10), (True, 0)):
+                with self.subTest(saved=saved):
+                    if saved is not None:
+                        data=desktop_input.load(prefs)
+                        data['keyboard']['numlock']=saved
+                        prefs.write_text(json.dumps(data))
+                    result=subprocess.run(command,env=env,timeout=3)
+                    self.assertEqual(result.returncode,expected)
+
+    def test_greeter_hook_reads_as_the_desktop_account(self):
+        hook = ROOT / 'runtime/usr/libexec/core-node-greeter-input'
+        config = ROOT / 'runtime/etc/lightdm/lightdm.conf.d/50-core-node-session.conf'
+        self.assertIn('greeter-setup-script=/usr/libexec/core-node-greeter-input',config.read_text())
+        self.assertTrue(os.access(hook,os.X_OK))
+        self.assertIn('--reuid=node --regid=node',hook.read_text())
+        subprocess.run(['/bin/sh','-n',str(hook)],check=True)
