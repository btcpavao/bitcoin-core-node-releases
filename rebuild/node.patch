+
+
+class Cookie(unittest.TestCase):
+    def test_reads_only_a_bounded_private_regular_cookie(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory)/'auth.cookie'
+            path.write_bytes(b'__cookie__:fixture')
+            path.chmod(0o640)
+            rpc = CoreRPC(path)
+            self.assertEqual(rpc._read_cookie(), b'__cookie__:fixture')
+            for mode in (0o660, 0o644):
