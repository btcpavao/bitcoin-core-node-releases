new file mode 100644
index 0000000000000000000000000000000000000000..f5b17276330eed7d98bddba8dacd393d1c427014
--- /dev/null
+++ b/app/pruning_space.py
@@ -0,0 +1,59 @@
+"""First-launch estimate for the actual blockchain drive, in Bitcoin Core GUI GB."""
+import os
+import subprocess
+
+from file_browser import check_core_view
+from state import CHAIN_IMPORT_RECEIPT, DATA, load_setup, verify_data_mount
+
+GB = 1_000_000_000
+# Bitcoin Core v32.1 src/kernel/chainparams.cpp, as displayed by Qt Intro.
+# (estimated block storage, estimated chainstate), before the Node growth allowance.
+CORE_ESTIMATES = {'main': (897, 14), 'signet': (25, 5), 'regtest': (0, 0)}
+GROWTH_GB = 11
+FREE_RESERVE_GB = 15
+
+
+def free_on_data_drive(setup, data=DATA):
+    fd = os.open(data, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        verify_data_mount(setup, data)
+        if not os.path.samestat(os.fstat(fd), os.stat(data, follow_symlinks=False)):
+            raise OSError('Blockchain drive changed')
+        space = os.fstatvfs(fd)
+        return space.f_bavail * space.f_frsize
+    finally:
+        os.close(fd)
+
+
+def pruning_estimate(free, network):
+    block_estimate, chainstate = CORE_ESTIMATES[network]
+    overhead = chainstate + GROWTH_GB
+    target = free // GB - overhead - FREE_RESERVE_GB
+    if target < 1:
+        caption = 'More free space needed for the suggested reserves'
+    elif target >= block_estimate:
+        caption = 'Estimated space for full history is available'
+    else:
+        caption = f'Suggested pruning target  {target} GB'
+    return dict(free=free, overhead=overhead, reserve=FREE_RESERVE_GB, caption=caption)
+
+
+def first_start_space():
+    try:
+        setup = load_setup()
+        network = setup['network']
+        view = check_core_view()
+        if network not in CORE_ESTIMATES:
+            return None
+        netdir = view if network == 'main' else view / network
+        # Stat the names only. A restored chain or an already-used drive must
+        # never be presented as an empty first-start drive.
+        for path in (view / CHAIN_IMPORT_RECEIPT, netdir / 'blocks', netdir / 'chainstate', netdir / 'debug.log'):
+            try:
+                path.lstat()
+            except FileNotFoundError:
+                continue
+            return None
+        return pruning_estimate(free_on_data_drive(setup), network)
+    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError):
+        return None
