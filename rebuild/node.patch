+
+
+class ConfirmDialog(QDialog):
+    def __init__(self, paths, mode, parent=None):
+        super().__init__(parent)
+        self.mode = None
+        self.error = None
+        title = 'Secure Delete' if mode == 'secure' else 'Quick Delete'
+        outer = prepare_dialog(self, title)
+        self.status = label('Checking the selected items…')
+        outer.addWidget(self.status)
+        outer.addWidget(label(DESCRIPTIONS[mode]))
+        self.paths = QPlainTextEdit(self)
+        self.paths.setReadOnly(True)
+        self.paths.setAccessibleName('Selected items to permanently delete')
+        visible = [plain(p) for p in paths[:100]]
+        if len(paths) > 100:
+            visible.append(f'… and {len(paths) - 100} more selected items')
+        self.paths.setPlainText('\n'.join(visible))
+        self.paths.setMinimumHeight(70)
+        self.paths.setMaximumHeight(110)
+        outer.addWidget(self.paths)
+        outer.addStretch(1)
+        buttons = QHBoxLayout()
+        buttons.addStretch(1)
+        self.cancel_button = QPushButton('Cancel', self)
+        self.confirm_button = QPushButton(title, self)
+        self.confirm_button.setObjectName('delete')
+        self.confirm_button.setAutoDefault(False)
+        self.confirm_button.setDefault(False)
+        self.confirm_button.setEnabled(False)
+        self.confirm_button.clicked.connect(lambda: self.choose(mode))
+        self.cancel_button.setDefault(True)
+        self.cancel_button.clicked.connect(self.reject)
+        buttons.addWidget(self.cancel_button)
+        buttons.addWidget(self.confirm_button)
+        outer.addLayout(buttons)
+        self.cancel_button.setFocus(Qt.FocusReason.OtherFocusReason)
+
+    @Slot(object)
+    def ready(self, plan):
+        self.status.setText(f'{plan.files_count} files, {plan.dirs_count} folders, '
+                            f'{plan.links_count} links · {size_text(plan.total_bytes)} logical size')
+        self.confirm_button.setEnabled(True)
+
+    @Slot(str)
+    def failed(self, error):
+        self.error = error
+        self.status.setText(error)
+        self.cancel_button.setText('Close')
+
+    def choose(self, mode):
+        self.mode = mode
+        self.accept()
+
+
+class Preflight(QThread):
+    ready = Signal(object)
+    failed = Signal(str)
+
+    def __init__(self, paths, mode):
+        super().__init__()
+        self.paths = paths
+        self.mode = mode
+        self.cancel_event = threading.Event()
+        self.plan = None
+        self.engine = None
+
+    def run(self):
+        try:
+            paths = node_paths(self.paths, self.cancel_event)
+            if self.cancel_event.is_set():
+                return
+            import file_erase
+            self.engine = file_erase
+            self.plan = self.engine.build_plan(paths, check_overwrite=self.mode == 'secure',
+                                               cancel_event=self.cancel_event)
+            if not self.cancel_event.is_set():
+                self.ready.emit(self.plan)
+        except Exception as exc:
+            if not self.cancel_event.is_set():
+                self.failed.emit(plain(exc))
+
+
+class Worker(QThread):
+    progress = Signal(dict)
+    done = Signal(object)
+
+    def __init__(self, engine, plan, mode, parent=None):
+        super().__init__(parent)
+        self.engine, self.plan, self.mode = engine, plan, mode
+        self.cancel_event = threading.Event()
+
+    def run(self):
+        try:
+            result = self.engine.erase(self.plan, self.cancel_event, self.progress.emit, mode=self.mode)
+        except Exception as exc:
+            # The engine owns restoration of staged entries and detailed results.
+            # Never turn an unexpected error into an ordinary-delete fallback.
+            result = self.engine.Result(
+                status='error', completed_files=0, completed_links=0,
+                message='Deletion stopped unexpectedly. Check the selected folders '
+                        'for remaining items. ' + plain(exc), leftover_paths=[])
+        self.done.emit(result)
+
+
+class ProgressDialog(QDialog):
+    def __init__(self, worker, plan, parent=None):
+        super().__init__(parent)
+        self.worker, self.plan = worker, plan
+        self.result = None
+        outer = prepare_dialog(self, 'Secure Delete' if worker.mode == 'secure' else 'Quick Delete')
+        self.status = label('Checking the selected items…')
+        outer.addWidget(self.status)
+        self.bar = QProgressBar(self)
+        self.bar.setRange(0, 0)
+        self.bar.setTextVisible(False)
+        outer.addWidget(self.bar)
+        self.current = QPlainTextEdit(self)
+        self.current.setReadOnly(True)
+        self.current.setAccessibleName('Item currently being permanently deleted')
+        self.current.setMinimumHeight(70)
+        self.current.setMaximumHeight(96)
+        outer.addWidget(self.current)
+        outer.addWidget(label('Stopping cannot restore contents already overwritten '
+                              'or items already deleted.', 'note'))
+        outer.addStretch(1)
+        row = QHBoxLayout()
+        row.addStretch(1)
+        self.stop_button = QPushButton('Stop', self)
+        self.stop_button.clicked.connect(self.request_stop)
+        row.addWidget(self.stop_button)
+        outer.addLayout(row)
+        worker.progress.connect(self.update_progress)
+        worker.done.connect(self.finished_work)
+        self.resize(620, 340)
+
+    def update_progress(self, event):
+        completed = event.get('completed_files', 0)
+        phase = event.get('phase', 'preparing')
+        verb = {'preparing': 'Checking items', 'overwriting': 'Overwriting file contents',
+                'removing': 'Removing items'}.get(phase, 'Deleting items')
+        self.status.setText(f'{verb} · {completed} of {self.plan.files_count} files completed')
+        self.current.setPlainText(plain(event.get('path', '')))
+
+    def request_stop(self):
+        self.worker.cancel_event.set()
+        self.stop_button.setEnabled(False)
+        self.stop_button.setText('Stopping…')
+
+    def reject(self):
+        if self.result is None:
+            self.request_stop()
+        else:
+            super().reject()
+
+    def closeEvent(self, event):
+        if self.result is None:
+            self.request_stop()
+            event.ignore()
+        else:
+            super().closeEvent(event)
+
+    def finished_work(self, result):
+        self.result = result
+        super().accept()
+
+
+def message(title: str, text: str):
+    dialog = QDialog()
+    dialog.setObjectName('PermanentDeletionMessage')
+    outer = prepare_dialog(dialog, title)
+    body = QPlainTextEdit(dialog)
+    body.setObjectName('messageBody')
+    body.setAccessibleName('Permanent deletion result and remaining items')
+    body.setReadOnly(True)
+    body.setPlainText('\n'.join(plain(line) for line in str(text).split('\n')))
+    body.setMinimumHeight(140)
+    body.setMaximumHeight(260)
+    outer.addWidget(body)
+    outer.addStretch(1)
+    row = QHBoxLayout()
+    row.addStretch(1)
+    button = QPushButton('Close', dialog)
+    button.clicked.connect(dialog.accept)
+    row.addWidget(button)
+    outer.addLayout(row)
+    dialog.resize(620, 400)
+    dialog.exec()
+
+
+def node_paths(values, cancel_event=None):
+    from file_browser import CORE_DATA, CORE_VIEW
+    if os.geteuid() == 0:
+        raise RuntimeError('Use Files from the ordinary Node desktop account.')
+    home = Path.home()
+    aliases = {home / 'Private Workspace': Path('/run/core-node-private/workspace'),
+               home / 'PSBT Transfer Folder': Path('/run/core-node-private/psbt')}
+    paths = []
+    for value in values:
+        if cancel_event is not None and cancel_event.is_set():
+            return []
+        path = Path(value)
+        if not path.is_absolute() or '..' in path.parts:
+            raise ValueError('Select local files or folders.')
+        path = Path('/') / str(path).lstrip('/')
+        for alias, target in aliases.items():
+            if path != alias and path.is_relative_to(alias) and alias.is_symlink() and alias.readlink() == target:
+                path = target / path.relative_to(alias)
+                break
+        if any(path.is_relative_to(root) or root.is_relative_to(path) for root in (CORE_VIEW, CORE_DATA)):
+            raise ValueError('Core files are read-only in Files. To securely delete a wallet, open Wallets on Home.')
+        paths.append(str(path))
+    return paths
+
+
+class AlreadyOpen(RuntimeError):
+    pass
+
+
+def raise_existing_dialog():
+    try:
+        subprocess.run(['/usr/bin/wmctrl', '-xa', 'core-node-file-delete'],
+                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
+    except (OSError, subprocess.TimeoutExpired):
+        pass
+
+
+def session_lock() -> int:
+    runtime = Path('/run/user') / str(os.getuid())
+    info = runtime.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
+        raise RuntimeError('The desktop runtime directory is unavailable.')
+    fd = os.open(runtime / 'core-node-file-delete.lock',
+                 os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
+            raise RuntimeError('The permanent-deletion session lock is unsafe.')
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise AlreadyOpen('Permanent deletion is already open.') from None
+        return fd
+    except Exception:
+        os.close(fd)
+        raise
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    modes = parser.add_mutually_exclusive_group(required=True)
+    modes.add_argument('--quick', action='store_const', const='quick', dest='mode')
+    modes.add_argument('--secure', action='store_const', const='secure', dest='mode')
+    parser.add_argument('paths', nargs='+')
+    args = parser.parse_args()
+    app = QApplication(['core-node-file-delete'])
+    app.setStyle('Fusion')
+    app.setFont(QFont('DejaVu Sans', 10))
+    lock_fd = None
+    preparation = None
+    try:
+        try:
+            lock_fd = session_lock()
+        except AlreadyOpen:
+            raise_existing_dialog()
+            return 0
+        confirm = ConfirmDialog(args.paths, args.mode)
+        preparation = Preflight(args.paths, args.mode)
+        preparation.ready.connect(confirm.ready)
+        preparation.failed.connect(confirm.failed)
+        confirm.show()
+        preparation.start()
+        if confirm.exec() != QDialog.DialogCode.Accepted or confirm.mode is None:
+            return 1 if confirm.error else 0
+        preparation.wait()
+        plan = preparation.plan
+        worker = Worker(preparation.engine, plan, confirm.mode)
+        progress = ProgressDialog(worker, plan)
+        worker.start()
+        progress.exec()
+        worker.wait()
+        result = progress.result
+        if result is None:
+            raise RuntimeError('Deletion ended without a result. Check the selected folders.')
+        if result.status == 'completed':
+            return 0
+        text = result.message
+        if result.leftover_paths:
+            text += '\n\nRemaining items:\n' + '\n'.join(plain(p) for p in result.leftover_paths)
+        message('Deletion stopped' if result.status == 'cancelled' else 'Deletion incomplete', text)
+        return 1
+    except Exception as exc:
+        message('Deletion could not start', plain(exc))
+        return 1
+    finally:
+        if preparation is not None:
+            preparation.cancel_event.set()
+        if lock_fd is not None:
+            os.close(lock_fd)
+        # Cancelled read-only work may still be finishing its bounded storage
+        # check. A fresh request can acquire the lock immediately.
+        if preparation is not None:
+            preparation.wait()
+            if preparation.plan is not None:
+                preparation.plan.close()
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
