+'''
+
+DESCRIPTIONS = {
+    'quick': 'Remove the selected items immediately, without overwriting. This cannot be undone.',
+    'secure': 'Overwrite regular files in three passes and a final zero pass, then remove them. On SSDs and USB flash drives, backups, snapshots or older physical copies can remain. Links are removed without touching their targets.',
+}
+
+
+def plain(value) -> str:
+    """Display names as plain text, with control characters visibly escaped."""
+    text = str(value).encode('utf-8', 'backslashreplace').decode('utf-8')
+    return ''.join(c if c.isprintable() else repr(c)[1:-1] for c in text)
+
+
+def size_text(number: int) -> str:
+    value = float(number)
+    for unit in ('B', 'kB', 'MB', 'GB', 'TB'):
+        if value < 1000 or unit == 'TB':
+            return f'{value:.1f} {unit}' if unit != 'B' else f'{int(value)} B'
+        value /= 1000
+
+
+def label(text: str, name='', parent=None) -> QLabel:
+    widget = QLabel(text, parent)
+    widget.setTextFormat(Qt.TextFormat.PlainText)
+    widget.setWordWrap(True)
+    if name:
