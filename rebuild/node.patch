+"""A receiving address always belongs to the currently selected wallet."""
+import os
+import sys
+import time
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+os.environ.setdefault('QT_QPA_PLATFORM','offscreen')
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'app'))
+from PySide6.QtCore import QObject, Signal
+from PySide6.QtWidgets import QApplication, QWidget
+from wallet_ui import WalletDialog
+from wallets import WalletError
+
+
+class PendingJob(QObject):
+    success = Signal(object)
+    failure = Signal(str)
+    finished = Signal()
+
+    def __init__(self, operation, parent):
+        super().__init__(parent)
+        self.running = False
+
+    def isRunning(self):
+        return self.running
+
+    def start(self):
+        self.running = True
+
+
+class WalletSelection(unittest.TestCase):
+    def test_switch_clears_address_and_late_result_is_ignored(self):
+        app = QApplication.instance() or QApplication([])
+        parent = QWidget()
+        parent.rpc = Mock()
+        with patch('wallet_ui.QTimer.singleShot'), patch('wallet_ui.WalletService'), patch('ui.Job',PendingJob):
+            dialog = WalletDialog(parent)
+            dialog.wallet.blockSignals(True)
+            dialog.wallet.addItems(['first','second'])
+            dialog.wallet.blockSignals(False)
+            dialog.address.setText('previous')
+            dialog.receive()
+            self.assertFalse(dialog.wallet.isEnabled())
+            self.assertEqual(dialog.address.text(),'')
+            job = dialog.job
+            dialog.wallet.setCurrentText('second')
+            job.success.emit('address-for-first')
+            job.running = False
+            job.finished.emit()
+            self.assertTrue(dialog.wallet.isEnabled())
+            self.assertEqual(dialog.address.text(),'')
+            dialog.address.setText('address-for-second')
+            dialog.wallet.setCurrentText('first')
+            self.assertEqual(dialog.address.text(),'')
+            dialog.job.running = False
+            dialog.close()
+
+    def test_dialog_reloads_native_wallets_after_close_and_reopen(self):
+        from PySide6.QtCore import QEventLoop, QTimer
+        app = QApplication.instance() or QApplication([])
+        parent = QWidget()
+        parent.rpc = Mock()
+        open_wallets = ['signing', 'public']
+        service = Mock()
+        service.rpc.side_effect = lambda method: list(open_wallets) if method == 'listwallets' else self.fail(method)
+        def identify(name):
+            if name == 'signing':
+                raise WalletError('Private keys enabled')
+        service.watch.side_effect = identify
+        service.snapshot.side_effect = lambda name: dict(
+            incomplete=False, balances={}, info={'scanning': False}, utxos=[], transactions=[], descriptor_id='synthetic'
+        )
+        def finished():
+            until = time.monotonic() + 4
+            while dialog.job is None or dialog.job.isRunning() or dialog.refresh_timer.isActive():
+                self.assertLess(time.monotonic(), until)
+                loop = QEventLoop()
+                QTimer.singleShot(10, loop.quit)
+                loop.exec()
+            app.processEvents()
+        with patch('wallet_ui.WalletService', return_value=service):
+            dialog = WalletDialog(parent)
+            dialog.show()
+            finished()
+            self.assertEqual(dialog.wallet.count(), 1)
+            self.assertEqual(dialog.selected_name(), 'public')
+            dialog.address.setText('still-valid')
+            dialog.refresh()
+            finished()
+            self.assertEqual(dialog.address.text(), 'still-valid')
+            open_wallets.remove('public')
+            dialog.refresh()
+            finished()
+            self.assertEqual(dialog.wallet.count(), 0)
+            self.assertFalse(dialog.receive_button.isEnabled())
+            self.assertIn('File → Open Wallet', dialog.status.text())
+            self.assertEqual(dialog.address.text(), '')
+            open_wallets.append('restored')
+            dialog.refresh()
+            finished()
+            self.assertEqual(dialog.selected_name(), 'restored')
+            self.assertTrue(dialog.receive_button.isEnabled())
+            self.assertIn('Wallet: restored', dialog.details.toPlainText())
+            self.assertEqual(dialog.address.text(), '')
+            dialog.close()
+
+
+if __name__=='__main__':
+    unittest.main()
