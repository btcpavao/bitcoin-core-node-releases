+"""Check the separation between live installer access and the installed Node."""
+import configparser
+from pathlib import Path
+import subprocess
+import unittest
+import xml.etree.ElementTree as ET
+
+
+ROOT = Path(__file__).resolve().parents[1]
+RUNTIME = ROOT / 'runtime'
+HELPER = '/usr/libexec/core-node-run-installer'
+
+
+class LiveInstallerTests(unittest.TestCase):
+    def test_only_live_user_gets_fixed_installer_action(self):
+        policy = ET.parse(RUNTIME / 'usr/share/polkit-1/actions/org.bitcoin-core-node.installer.policy')
+        action = policy.find('action')
+        self.assertEqual(action.get('id'), 'org.bitcoin-core-node.installer')
+        self.assertEqual({node.text for node in action.find('defaults')}, {'no'})
+        annotations = {node.get('key'): node.text for node in action.findall('annotate')}
+        self.assertEqual(annotations, {'org.freedesktop.policykit.exec.path': HELPER})
+        rule = (RUNTIME / 'usr/share/bitcoin-core-node/installer-live.rules').read_text()
+        for condition in ('"org.bitcoin-core-node.installer"', '"node-live"', 'subject.local === true',
+                          'subject.active === true', 'action.lookup("user") === "root"',
+                          'action.lookup("program") === "' + HELPER + '"'):
+            self.assertIn(condition, rule)
+        self.assertFalse((RUNTIME / 'etc/polkit-1/rules.d/48-core-node-installer.rules').exists())
+
+    def test_debian_live_configuration_precedes_lightdm(self):
+        config = RUNTIME / 'etc/live/config.conf.d/core-node-installer.conf'
+        settings = {line for line in config.read_text().splitlines() if line and not line.startswith('#')}
+        self.assertEqual(settings, {'LIVE_CONFIG_NOROOT=true', 'LIVE_CONFIG_NOTTYAUTOLOGIN=true'})
+        post = configparser.ConfigParser()
+        post.read(RUNTIME / 'etc/systemd/system/live-config.service.d/core-node-installer.conf')
+        self.assertEqual(post['Service']['ExecStartPost'], '/usr/libexec/core-node-lock-live-user')
+        display = configparser.ConfigParser()
+        display.read(RUNTIME / 'etc/systemd/system/lightdm.service.d/core-node-live-config.conf')
+        self.assertIn('live-config.service', display['Unit']['Requires'].split())
+        self.assertIn('live-config.service', display['Unit']['After'].split())
+        target = (RUNTIME / 'usr/libexec/core-node-install-target').read_text()
+        self.assertIn("'etc/systemd/system/lightdm.service.d/core-node-live-config.conf'", target)
+
+    def test_live_installer_entry_points_and_arguments(self):
+        launcher = RUNTIME / 'usr/share/applications/install-core-node.desktop'
+        self.assertIn('Exec=/usr/bin/pkexec ' + HELPER, launcher.read_text().splitlines())
+        session = RUNTIME / 'usr/local/bin/core-node-installer-session'
+        self.assertIn('/usr/bin/pkexec ' + HELPER + ' ', session.read_text())
+        script = RUNTIME / HELPER.lstrip('/')
+        result = subprocess.run([str(script), '--help'], check=False)
+        self.assertNotEqual(result.returncode, 0)
+        for runtime_check in ('/etc/bitcoin-core-node/installed', 'boot=live', '/usr/bin/env -i',
+                              'XAUTHORITY=/run/lightdm/root/:0', '/usr/bin/calamares </dev/null'):
+            self.assertIn(runtime_check, script.read_text())
+
+    def test_installed_and_live_use_same_supported_session(self):
+        session = RUNTIME / 'usr/share/xsessions/core-node.desktop'
+        self.assertIn('Exec=/usr/local/bin/core-node-session', session.read_text().splitlines())
+        settings = (RUNTIME / 'etc/calamares/modules/displaymanager.conf').read_text()
+        self.assertIn('executable: /usr/local/bin/core-node-session', settings)
+        self.assertIn('desktopFile: core-node', settings)
