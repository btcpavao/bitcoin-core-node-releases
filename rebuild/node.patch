+def open_maintenance_lock(path=Path('/run/core-node-chain.lock')):
+    # systemd-tmpfiles creates this inode in /run before the installed service
+    # starts. Both the root broker and recovery take flock on this same inode.
+    fd = os.open(path, FILE_FLAGS)
+    info = os.fstat(fd)
+    if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or
+            info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600):
+        os.close(fd)
+        raise ChainError('Unsafe blockchain maintenance lock.')
+    return os.fdopen(fd, 'rb')
+
+
+@contextmanager
+def maintenance_data(data=DATA):
+    # Run only after Core stops and under the maintenance lock. The mountpoint
+    # is directly below a root-owned directory. Temporarily protect its names
+    # (including legacy journals) while root reads or publishes a transaction.
+    # Recovery repeats this operation even if power failed before restoration.
+    account = pwd.getpwnam('bitcoinnode')
+    fd = os.open(data, DIR_FLAGS)
+    try:
+        if os.fstat(fd).st_uid not in (0, account.pw_uid):
+            raise ChainError('Unexpected owner of the installed Core data directory.')
+        os.fchown(fd, 0, account.pw_gid)
+        try:
+            os.fchmod(fd, 0o710)
+            yield
+        finally:
+            os.fchmod(fd, 0o700)
+            os.fchown(fd, account.pw_uid, account.pw_gid)
+    finally:
+        os.close(fd)
+
+
