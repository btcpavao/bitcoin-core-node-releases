diff --git a/tests/test_wallet_manager.py b/tests/test_wallet_manager.py
new file mode 100644
index 0000000000000000000000000000000000000000..24dd8bf47faea316e346e6c92ef927ce583114ce
--- /dev/null
+++ b/tests/test_wallet_manager.py
@@ -0,0 +1,82 @@
+import os
+import sqlite3
+import sys
+import tempfile
+import unittest
+from contextlib import ExitStack, closing
+from pathlib import Path
+from unittest.mock import patch
+
+os.environ.setdefault('QT_QPA_PLATFORM','offscreen')
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'app'))
+from rpc import CoreError
+from wallet_presence import wallet_inventory
+from wallets import WalletError, WalletService, wallet_kind
+import wallet_delete
+
+
+class WalletManager(unittest.TestCase):
+    def test_core_classifies_without_loading_closed_wallets(self):
+        info = {
+            'signing': {'private_keys_enabled': True, 'external_signer': False, 'unlocked_until': 0},
+            'public': {'private_keys_enabled': False, 'external_signer': False, 'descriptors': True},
+            'device': {'private_keys_enabled': False, 'external_signer': True, 'descriptors': True},
+            '/external/wallet': {},
+        }
+        def rpc(method, *, wallet=None):
+            if method == 'listwalletdir':
+                return {'wallets': [{'name': name} for name in ('public', 'closed', 'signing', 'device')]}
+            if method == 'listwallets':
+                return list(info)
+            if method == 'getwalletinfo':
+                return info[wallet]
+            self.fail(method)
+        with patch('wallet_presence.disk_wallet_names',return_value={'public','closed','signing','device'}):
+            result = wallet_inventory(rpc)
+        self.assertTrue(result['online'])
+        rows = {row['name']:row for row in result['rows']}
+        self.assertEqual({n:r['kind'] for n,r in rows.items()}, {
+            'signing':'Private keys enabled','public':'Watch-only','device':'External signer',
+            '/external/wallet':'Unknown','closed':'Unknown'})
+        self.assertFalse(rows['/external/wallet']['managed'])
+        self.assertTrue(rows['closed']['managed'])
+        self.assertFalse(rows['closed']['loaded'])
+        self.assertEqual([n for n,r in rows.items() if r['watch_tools']], ['public'])
+        with tempfile.TemporaryDirectory() as tmp:
+            service=WalletService(rpc,tmp)
+            with self.assertRaises(WalletError):service.watch('device')
+
+    def test_unavailable_core_never_guesses_wallet_type(self):
+        def offline(*args,**kwargs):raise CoreError('offline')
+        with patch('wallet_presence.disk_wallet_names',return_value={'looks-watch-only'}):
+            inv = wallet_inventory(offline)
+        self.assertTrue(inv['known'])
+        self.assertFalse(inv['online'])
+        row, = inv['rows']
+        self.assertEqual(row['kind'],'Unknown')
+        self.assertTrue(row['managed'])
+        self.assertIsNone(row['loaded'])
+        self.assertEqual(wallet_kind(None),'Unknown')
+
+    def test_loaded_and_reopened_wal_database_blocks_live_erase(self):
+        # A second process owns a SQLite write lock. The real interprocess lock
+        # attempt must fail even if a stale RPC result claims nothing is open.
+        import subprocess
+        with tempfile.TemporaryDirectory() as tmp, ExitStack() as stack:
+            root = Path(tmp)/'wallets'
+            wallet = root/'held'
+            wallet.mkdir(parents=True)
+            db = wallet/'wallet.dat'
+            with closing(sqlite3.connect(db)) as con, con:
+                con.execute('CREATE TABLE t(n INTEGER)')
+            child = subprocess.Popen([sys.executable,'-c',
+                'import sqlite3,sys; c=sqlite3.connect(sys.argv[1]); c.execute("BEGIN IMMEDIATE"); print("locked",flush=True); sys.stdin.read()',str(db)],
+                stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True)
+            try:
+                self.assertEqual(child.stdout.readline().strip(),'locked')
+                with patch.object(wallet_delete,'WALLET_ROOT',root), patch.object(wallet_delete,'CoreRPC',return_value=lambda *args:[]):
+                    with self.assertRaises(BlockingIOError):
+                        wallet_delete.lock_closed_wallets(['held'], root.parent/'settings.json', os.getuid(), stack)
+                self.assertTrue(db.exists())
+            finally:
+                child.stdin.close(); child.wait(timeout=5); child.stdout.close()
