+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'app'))
+import chain_backup as chain
+import login
+import watch_backup
+from rpc import CoreRPC
+from wallets import WalletError
+
+
+class Cookie(unittest.TestCase):
+    def test_reads_only_a_bounded_private_regular_cookie(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory)/'auth.cookie'
+            path.write_bytes(b'__cookie__:fixture')
+            path.chmod(0o640)
+            rpc = CoreRPC(path)
+            self.assertEqual(rpc._read_cookie(), b'__cookie__:fixture')
+            for mode in (0o660, 0o644):
+                path.chmod(mode)
+                with self.assertRaises(ValueError):
+                    rpc._read_cookie()
+            path.chmod(0o600)
+            path.write_bytes(b'x:' + b'0'*1023)
+            with self.assertRaises(ValueError):
+                rpc._read_cookie()
+            path.unlink()
+            os.mkfifo(path, mode=0o600)
+            with self.assertRaises(ValueError):
+                rpc._read_cookie()
+
+
+class FirstPassword(unittest.TestCase):
+    def test_initial_setup_refuses_an_active_password_or_removal(self):
+        for marker, shadow_hash, required in ((False, '!', True), (True, 'active-hash', True),
+                                              (True, '!locked', False)):
+            with self.subTest(marker=marker, shadow_hash=shadow_hash, required=required), \
+                    tempfile.TemporaryDirectory() as directory, ExitStack() as stack:
+                root = Path(directory)
+                (root/'installed').touch()
+                (root/'shadow').write_text('node:' + shadow_hash + ':20000:0:99999:7:::\n')
+                (root/'lightdm').write_text(login.lightdm_text(False))
+                stack.enter_context(patch.multiple(login, CONFIG=root, SHADOW=root/'shadow', LIGHTDM=root/'lightdm'))
+                stack.enter_context(patch.object(login.os, 'geteuid', return_value=0))
+                stack.enter_context(patch.object(login.pwd, 'getpwnam', return_value=SimpleNamespace(pw_uid=1000)))
+                stack.enter_context(patch.object(login, 'passwordless', return_value=marker))
+                run = stack.enter_context(patch.object(login.subprocess, 'run'))
+                request = {'required': required}
+                if required:
+                    request['password'] = 'example'
+                with self.assertRaises(WalletError):
+                    login.configure(request, initialize=True)
+                run.assert_not_called()
+
+
+@unittest.skipUnless(os.geteuid() == 0, 'requires root or a disposable user namespace')
+class Maintenance(unittest.TestCase):
+    def test_watch_restore_stages_a_root_owned_database_with_owner_write(self):
+        with tempfile.TemporaryDirectory() as directory, ExitStack() as stack:
+            base = Path(directory)
+            stage = base/'work'
+            stage.mkdir(mode=0o700)
+            stack.enter_context(patch.object(watch_backup, 'STATE', base/'receipts'))
+            stack.enter_context(patch.object(watch_backup, 'core_ram', return_value=nullcontext(stage)))
+            account = SimpleNamespace(pw_gid=os.getgid())
+            stack.enter_context(patch.object(watch_backup.pwd, 'getpwnam', return_value=account))
+            raw = b'public test fixture'
+            data = {'wallets': [{'name': 'watch', 'public_export': base64.b64encode(raw).decode()}]}
+            staged = []
+            def rpc(method, *args, **kwargs):
+                if method == 'listwalletdir': return {'wallets': []}
+                if method == 'getwalletinfo': return {'private_keys_enabled': False, 'descriptors': True}
+                self.assertEqual(method, 'restorewallet')
+                name, path, load_on_start = args
+                path = Path(path)
+                self.assertEqual((name, path.parent, load_on_start), ('watch', stage, True))
+                info = path.stat()
+                staged.append((info.st_uid, info.st_gid, stat.S_IMODE(info.st_mode), path.read_bytes()))
+            result = watch_backup.import_wallets(data, 'a'*64, rpc, chain.Events(emit=lambda row: None))
+            self.assertEqual(result['names'], ['watch'])
+            self.assertEqual(staged, [(0, account.pw_gid, 0o640, raw)])
+
+    def test_existing_lock_and_data_permissions_survive_an_interruption(self):
+        with tempfile.TemporaryDirectory() as directory:
+            data = Path(directory)
+            account = SimpleNamespace(pw_uid=os.getuid(), pw_gid=os.getgid())
+            lock = data/'chain.lock'
+            lock.touch(mode=0o600)
+            with chain.open_maintenance_lock(lock) as fd:
+                self.assertEqual(os.fstat(fd.fileno()).st_ino, lock.stat().st_ino)
+            with patch.object(chain.pwd, 'getpwnam', return_value=account):
+                with self.assertRaises(InterruptedError), chain.maintenance_data(data):
+                    self.assertEqual(stat.S_IMODE(data.stat().st_mode), 0o710)
+                    raise InterruptedError()
+                self.assertEqual(stat.S_IMODE(data.stat().st_mode), 0o700)
+            lock.chmod(0o666)
+            with self.assertRaises(chain.ChainError):
+                chain.open_maintenance_lock(lock)
