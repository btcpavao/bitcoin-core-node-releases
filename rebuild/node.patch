@@ -0,0 +1,102 @@
+#!/usr/bin/python3
+"""Check the painted dock, EWMH bounds, progress and storage with a real X11 display."""
+import argparse
+import ctypes
+from pathlib import Path
+import runpy
+import subprocess
+import sys
+import time
+from types import SimpleNamespace
+
+from PySide6.QtWidgets import QApplication, QWidget
+
+parser = argparse.ArgumentParser()
+mode = parser.add_mutually_exclusive_group(required=True)
+mode.add_argument('--isolated', action='store_true', help='Run in a new Xvfb display with no window manager')
+mode.add_argument('--installed', action='store_true', help='Use the installed Node panel in its QA desktop')
+args = parser.parse_args()
+if args.installed:
+    bindir = Path('/usr/local/bin')
+    appdir = Path('/usr/lib/bitcoin-core-node')
+else:
+    source = Path(__file__).resolve().parents[1]
+    bindir = source / 'runtime/usr/local/bin'
+    appdir = source / 'app'
+app = QApplication([])
+panel_module = runpy.run_path(str(bindir / 'core-node-taskbar'), run_name='visual_check')
+wm = None
+task = None
+panel = None
+
+def wait(predicate, timeout=8):
+    end = time.monotonic() + timeout
+    while time.monotonic() < end:
+        app.processEvents()
+        result = predicate()
+        if result:
+            return result
+        time.sleep(.05)
+    raise AssertionError('Timed out waiting for ' + predicate.__name__)
+
+try:
+    x = panel_module['Windows']()
+    if args.isolated:
+        assert not x.prop(x.root, '_NET_SUPPORTING_WM_CHECK'), 'Use a fresh Xvfb display'
+        wm = subprocess.Popen(['openbox'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        wait(lambda: x.prop(x.root, '_NET_SUPPORTING_WM_CHECK'))
+    task = QWidget()
+    task.setWindowTitle('Bitcoin Core Node display test')
+    task.resize(240, 120)
+    task.show()
+    wait(lambda: int(task.winId()) in x.managed())
+    if args.isolated:
+        panel = panel_module['Taskbar'](SimpleNamespace(
+            assets=source / 'runtime/usr/share/bitcoin-core-node', preview=False))
+    def panel_window():
+        return next((wid for wid in x.managed() if x.title(wid) == 'Core Node Taskbar'), None)
+    wid = wait(panel_window)
+    screen = app.primaryScreen()
+    probe = runpy.run_path(str(bindir / 'core-display-scale'), run_name='screen_probe')['probe']
+    output = next(o for o in probe() if o['name'] == screen.name())
+    left, right = output['x'], output['x'] + output['width'] - 1
+    x.lib.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
+    root_height = x.lib.XDisplayHeight(x.display, x.screen)
+    bottom = root_height - output['y'] - output['height'] + round(40 * screen.devicePixelRatio())
+    def painted_panel_reserves_exact_output():
+        s = x.prop(wid, '_NET_WM_STRUT_PARTIAL')
+        return (s and (s[3], s[10], s[11]) == (bottom, left, right)
+                and x.native_strut(wid) == (bottom, left, right))
+    wait(painted_panel_reserves_exact_output)
+    pixels = screen.grabWindow(0).toImage()
+    assert pixels.width() == output['width'] and pixels.height() == output['height']
+    for col in (0, pixels.width()-2, pixels.width()-1):
+        assert pixels.pixelColor(col, pixels.height()-4).name() == '#111111', col
+
+    sys.path.insert(0, str(appdir))
+    from activity_ui import ActivityIndicator, StorageBar
+    from pruning_space import GB, pruning_estimate
+    from chain_storage import reading
+    assert GB == 1_000_000_000
+    assert '60 GB' in pruning_estimate(100 * GB, 'main')['caption']
+    storage = StorageBar()
+    storage.update_space(reading(30 * GB, 60 * GB))
+    assert '60.0 GB free of 90.0 GB' in storage.caption.text()
+    storage.hide()
+    indicator = ActivityIndicator()
+    indicator.resize(400, 13)
+    for state, estimate, expected in [('syncing', .5, '#f2c94c'), ('synchronized', 1., '#55d68b')]:
+        indicator.set_state(state, progress=estimate)
+        painted = indicator.grab().toImage()
+        row = [painted.pixelColor(i, painted.height()//2).name() for i in range(painted.width())]
+        length = round(painted.width() * estimate)
+        assert all(pixel == expected for pixel in row[:length-1])
+        assert all(pixel == '#353535' for pixel in row[length+1:])
+    print(f"PASS panel and last pixel at {output['width']}x{output['height']} "
+          f"scale {screen.devicePixelRatio()}, continuous sync colors and decimal GB", flush=True)
+finally:
+    if task is not None:
+        task.hide()
+    if wm is not None:
+        wm.terminate()
+        wm.wait(timeout=5)
