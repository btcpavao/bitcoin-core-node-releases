diff --git a/app/text_clipping.py b/app/text_clipping.py
new file mode 100644
index 0000000000000000000000000000000000000000..62fd8e4ce224b59b48592c1a5672a4f056b7d2db
--- /dev/null
+++ b/app/text_clipping.py
@@ -0,0 +1,211 @@
+"""Read Finder plain-text clippings from their data fork or locally stored resource fork."""
+import codecs
+import os
+from pathlib import Path
+import plistlib
+import stat
+import struct
+import sys
+from xml.parsers.expat import ExpatError
+
+LIMIT = 2 * 1024 * 1024
+UNREADABLE = 'No readable plain text was found. On the Mac, save the text as a .txt file or copy the clipping again with its resource fork.'
+
+
+class ClippingError(ValueError):
+    pass
+
+
+def bounded_file(path):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, 'rb') as stream:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_size > LIMIT:
+            raise ClippingError('Choose a regular text clipping of up to 2 MB.')
+        data = stream.read(LIMIT + 1)
+        if len(data) > LIMIT:
+            raise ClippingError('The clipping exceeds the 2 MB limit.')
+        return data
+
+
+def decode_text(data, encoding):
+    if isinstance(data, str):
+        text = data
+    elif isinstance(data, bytes):
+        if encoding in ('utf-16-be', 'utf-16-le'):
+            if data.startswith((codecs.BOM_UTF16_BE, codecs.BOM_UTF16_LE)):
+                encoding = 'utf-16'
+            else:
+                # Older Macintosh resources and modern native-endian pasteboard
+                # flavors can disagree about byte order when there is no BOM.
+                even, odd = data[::2].count(0), data[1::2].count(0)
+                if even != odd:
+                    encoding = 'utf-16-be' if even > odd else 'utf-16-le'
+        try:
+            text = data.decode(encoding)
+        except UnicodeError:
+            return None
+    else:
+        return None
+    if not text or '\0' in text or any(0xD800 <= ord(c) <= 0xDFFF for c in text):
+        return None
+    return text
+
+
+def plist_text(data):
+    if data.startswith(b'bplist00'):
+        if len(data) < 40:
+            return None
+        width, ref_width, count, root, table = struct.unpack('>6xBBQQQ', data[-32:])
+        if (width not in (1, 2, 4, 8) or ref_width not in (1, 2, 4, 8) or
+                not 0 <= root < count <= 65536 or not 8 <= table <= len(data)-32-count*width):
+            return None
+    try:
+        value = plistlib.loads(data)
+    except (plistlib.InvalidFileException, ValueError, TypeError, RecursionError, OverflowError,
+            struct.error, ExpatError):
+        return None
+    formats = value.get('UTI-Data') if isinstance(value, dict) else None
+    if not isinstance(formats, dict):
+        return None
+    for key, encoding in (('public.utf8-plain-text', 'utf-8'), ('public.utf16-external-plain-text', 'utf-16'),
+                          ('public.utf16-plain-text', 'utf-16-le'), ('com.apple.traditional-mac-plain-text', 'mac_roman')):
+        text = decode_text(formats.get(key), encoding)
+        if text is not None:
+            return text
+    return None
+
+
+def region(data, offset, size):
+    if offset < 0 or size < 0 or offset + size > len(data):
+        raise ClippingError(UNREADABLE)
+    return data[offset:offset + size]
+
+
+def resource_text(blob):
+    """Classic resource map: resource type table, then ID 256 and a 24-bit data offset."""
+    if len(blob) < 16:
+        return None
+    data_offset, map_offset, data_size, map_size = struct.unpack('>4I', blob[:16])
+    contents = region(blob, data_offset, data_size)
+    table = region(blob, map_offset, map_size)
+    type_offset = int.from_bytes(region(table, 24, 2), 'big')
+    type_table = table[type_offset:]
+    type_count = int.from_bytes(region(type_table, 0, 2), 'big') + 1
+    entries = region(type_table, 2, type_count * 8)
+    encodings = {b'utf8': 'utf-8', b'ut16': 'utf-16', b'utxt': 'utf-16-be', b'TEXT': 'mac_roman'}
+    candidates = {}
+    for kind, count_minus_one, refs in struct.iter_unpack('>4sHH', entries):
+        if kind not in encodings or kind in candidates:
+            continue
+        refs_data = region(type_table, refs, (count_minus_one + 1) * 12)
+        for entry in struct.iter_unpack('>hH4sI', refs_data):
+            if entry[0] != 256:
+                continue
+            pos = int.from_bytes(entry[2][1:], 'big')
+            size = int.from_bytes(region(contents, pos, 4), 'big')
+            candidates[kind] = region(contents, pos + 4, size)
+            break
+    for kind, encoding in encodings.items():
+        text = decode_text(candidates.get(kind), encoding)
+        if text is not None:
+            return text
+    return None
+
+
+def appledouble_fork(data):
+    if len(data) < 26 or data[:4] != b'\x00\x05\x16\x07':
+        return None
+    count = int.from_bytes(data[24:26], 'big')
+    headers = region(data, 26, count * 12)
+    for entry_id, offset, size in struct.iter_unpack('>III', headers):
+        if entry_id == 2:
+            return region(data, offset, size)
+    return None
+
+
+def read_clipping(path):
+    path = Path(path)
+    if path.suffix.lower() != '.textclipping' or path.name.startswith('._'):
+        raise ClippingError('Open the original .textClipping file.')
+    data = bounded_file(path)
+    if data:
+        text = plist_text(data)
+        if text is not None:
+            return text
+    # Old Finder clippings store text in the resource fork. FAT/exFAT copies
+    # usually represent that fork in a companion AppleDouble file.
+    for name in ('user.com.apple.ResourceFork', 'com.apple.ResourceFork'):
+        try:
+            blob = os.getxattr(path, name, follow_symlinks=False)
+        except OSError:
+            continue
+        text = resource_text(blob)
+        if text is not None:
+            return text
+    try:
+        sidecar = bounded_file(path.with_name('._' + path.name))
+    except FileNotFoundError:
+        sidecar = b''
+    fork = appledouble_fork(sidecar)
+    if fork:
+        text = resource_text(fork)
+        if text is not None:
+            return text
+    raise ClippingError(UNREADABLE)
+
+
+def main():
+    from PySide6.QtWidgets import QApplication, QDialog, QHBoxLayout, QLabel, QPlainTextEdit, QPushButton, QVBoxLayout
+    from PySide6.QtCore import Qt
+    app = QApplication(['core-node-text-clipping'])
+    from ui import configure_ui
+    configure_ui(app)
+    dialog = QDialog()
+    dialog.setWindowTitle('Text Clipping')
+    dialog.resize(570, 285)
+    layout = QVBoxLayout(dialog)
+    try:
+        if len(sys.argv) != 2:
+            raise ClippingError('Open one .textClipping file at a time.')
+        path = Path(sys.argv[1])
+        text = read_clipping(path)
+        name = QLabel()
+        name.setTextFormat(Qt.PlainText)
+        name.setText(path.name)
+        layout.addWidget(name)
+        view = QPlainTextEdit()
+        view.setReadOnly(True)
+        view.setPlainText(text)
+        view.setAccessibleName('Text from clipping')
+        layout.addWidget(view)
+    except (OSError, ValueError) as exc:
+        text = None
+        status = QLabel()
+        status.setTextFormat(Qt.PlainText)
+        status.setText(str(exc))
+        status.setWordWrap(True)
+        layout.addWidget(status)
+    row = QHBoxLayout()
+    row.addStretch()
+    if text is not None:
+        copy = QPushButton('Copy Text')
+        def copy_text():
+            app.clipboard().setText(text)
+            copy.setText('Copied')
+        copy.clicked.connect(copy_text)
+        row.addWidget(copy)
+    close = QPushButton('Close')
+    close.clicked.connect(dialog.accept)
+    row.addWidget(close)
+    layout.addLayout(row)
+    # On X11 the selection owner serves the clipboard. Preserve Copy Text after
+    # closing the viewer, then leave as soon as the next clipboard owner takes over.
+    app.setQuitOnLastWindowClosed(False)
+    def quit_if_finished():
+        if not dialog.isVisible() and not app.clipboard().ownsClipboard():
+            app.quit()
+    dialog.finished.connect(quit_if_finished)
+    app.clipboard().dataChanged.connect(quit_if_finished)
+    dialog.show()
+    return app.exec()
