+        return False
+    for name in names:
+        marker = WALLET_ROOT/name/'wallet.dat'
+        fd = os.open(marker, os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+        locks.callback(os.close, fd)
+        st = os.fstat(fd)
