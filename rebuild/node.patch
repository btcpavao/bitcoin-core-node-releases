diff --git a/runtime/usr/share/bitcoin-core-node/installer-live.rules b/runtime/usr/share/bitcoin-core-node/installer-live.rules
new file mode 100644
index 0000000000000000000000000000000000000000..7e26a57b778694448f0f378d9aa8352c0ef54243
--- /dev/null
+++ b/runtime/usr/share/bitcoin-core-node/installer-live.rules
@@ -0,0 +1,9 @@
+// Installed in polkit's rules directory only during a live installer boot.
+polkit.addRule(function(action, subject) {
+    if (action.id !== "org.bitcoin-core-node.installer") return;
+    if (subject.user === "node-live" && subject.local === true &&
+        subject.active === true && action.lookup("user") === "root" &&
+        action.lookup("program") === "/usr/libexec/core-node-run-installer")
+        return polkit.Result.YES;
+    return polkit.Result.NO;
+});
