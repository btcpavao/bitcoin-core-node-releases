+def lock_closed_wallets(names, settings, uid, locks):
+    """Try live deletion. Hold SQLite-compatible write locks until each database is unlinked."""
+    rpc = CoreRPC(timeout=30)
+    for wallet in rpc('listwallets'):
+        if local_name(wallet, WALLET_ROOT) in names:
+            rpc('unloadwallet', wallet, False)
+    # Core can hold relative/absolute aliases or stale entries for an unloaded
+    # wallet. Core owns settings.json while live. Edit it only in the stopped path.
+    record, _ = read_settings(settings, uid)
