[Unit]
Description=Bitcoin Core graphical node
After=core-node-media.service core-node-private.service network-online.target bitcoin-core-node-policy.service display-manager.service
Wants=network-online.target core-node-media.service
Requires=bitcoin-core-node-policy.service core-node-private.service
ConditionPathExists=/etc/bitcoin-core-node/setup.json
ConditionPathExists=/etc/bitcoin-core-node/installed
RequiresMountsFor=/var/lib/bitcoin-core-node/data

[Service]
Type=simple
User=bitcoinnode
Group=bitcoin-rpc
UMask=0077
RuntimeDirectory=bitcoin-core-node
RuntimeDirectoryMode=0750
Environment=QT_ENABLE_HIGHDPI_SCALING=1 QT_SCALE_FACTOR_ROUNDING_POLICY=PassThrough
Environment=HOME=/var/lib/bitcoin-core-node/gui DISPLAY=:0 QT_QPA_PLATFORM=xcb
ExecStartPre=+/usr/libexec/core-node-chain-recover
ExecStart=/usr/libexec/core-node-daemon
Restart=no
TimeoutStopSec=300
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/core-node-media /run/core-node-private/workspace /run/core-node-private/psbt /var/lib/bitcoin-core-node/data /var/lib/bitcoin-core-node/gui /run/bitcoin-core-node
ReadOnlyPaths=/tmp /var/tmp /dev/shm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictSUIDSGID=true
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
